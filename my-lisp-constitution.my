(fixture (expr . "(let ((car (lambda (x) 'shadowed))) (car '(1 2)))") (expected . "1") (tier . 1) (axioms G4) (role . "constitutive") (note . "the seven primitives are syntax, dispatched before any environment lookup, so never shadowable — the same distinction Scheme draws between special forms and procedures"))
(fixture (expr . "(reverse '())") (expected . "()") (tier . 3) (axioms G5) (note . "empty-list edge case, previously untested"))
