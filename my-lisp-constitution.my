(fixture (expr . "(understand '(earth is a planet))") (expected . "((planet earth))") (tier . 3) (axioms) (note . "lib/understand.my — the controlled-natural-language bridge, previously tested only in Rust unit tests, not the implementation-independent contract"))
(fixture (expr . "(understand '(earth orbits sun))") (expected . "((orbits earth sun))") (tier . 3) (axioms) (note . "subject-verb-object relation shape"))
(fixture (expr . "(understand '(all planet have mass))") (expected . "((has (var w) mass) (planet (var w)))") (tier . 3) (axioms) (note . "universal-rule shape"))
(fixture (expr . "(narrate-fact (car (understand '(earth is a planet))))") (expected . "(earth is a planet)") (tier . 3) (axioms) (note . "lib/narrate.my — the structure-to-text half of the bridge, previously tested only in Rust unit tests"))
(fixture (expr . "(equal? '(mars is a planet) (narrate-fact (car (understand '(mars is a planet)))))") (expected . "t") (tier . 3) (axioms) (note . "understand and narrate-fact are direct inverses for the is-a shape"))
(fixture (expr . "(cond (0 'truthy) (t 'falsy))") (expected . "truthy") (tier . 1) (axioms) (note . "0 is truthy in my-lisp, unlike C/Python/JS — only Nil and Bool(false) are falsy (Value::is_truthy). Not G8: G8 is narrowly about '() as list/boolean, not a general \"empty-shaped values are false\" rule. Independent of the item-10 exactness redesign — is_truthy never inspects a number's exactness, only Nil/Bool(false)."))
(fixture (expr . "(eq 3 3.0)") (expected . "()") (tier . 1) (axioms S1) (note . "PLAN.md item 10, Path A: exactness is part of a number's identity — an exact integer and an inexact real of the same magnitude are different values, so eq (identity/atom equality) tells them apart."))
(fixture (expr . "(eq 3 3)") (expected . "t") (tier . 1) (axioms S1) (note . "same exactness, same magnitude"))
(fixture (expr . "(eq 3.0 3.0)") (expected . "t") (tier . 1) (axioms S1) (note . "same inexact value both sides"))
(fixture (expr . "(= 3 3.0)") (expected . "t") (tier . 1) (axioms S1) (note . "= compares magnitude only, deliberately diverging from eq — 3 and 3.0 are the same mathematical quantity even though they are different values"))
(fixture (expr . "(print 3)") (expected . "3") (tier . 2) (axioms S1) (note . "exact integer prints without a decimal point"))
(fixture (expr . "(print 3.0)") (expected . "3.0") (tier . 2) (axioms S1) (note . "inexact real always prints with a decimal point, even when whole-valued — the fix for the original bug this item was opened for: (+ 2.0 1.0) used to print as \"3\", silently erasing the written-with-a-decimal-point intent"))
(fixture (expr . "(print 3.00)") (expected . "3.0") (tier . 2) (axioms S1) (note . "3.0/3.00/3.000 are the same inexact value regardless of trailing zeros in the literal — canonical print form has exactly one decimal digit for a whole inexact number"))
(fixture (expr . "(+ 2.0 1.0)") (expected . "3.0") (tier . 2) (axioms S1) (note . "inexact + inexact -> inexact; this is the exact expression that first exposed the bug (used to evaluate to 3, losing all trace of the decimal points)"))
(fixture (expr . "(+ 2.0 1)") (expected . "3.0") (tier . 2) (axioms S1) (note . "exact + inexact -> inexact, one inexact operand contaminates the result"))
(fixture (expr . "(+ 2 1)") (expected . "3") (tier . 2) (axioms S1) (note . "exact + exact -> exact, stays a precise integer"))
(fixture (expr . "(string-append \"hello, \" \"world\")") (expected . "\"hello, world\"") (tier . 2) (axioms) (note . "PLAN.md item 14 — genuinely needs a Rust primitive, unlike string-length/string-contains? below: no existing primitive combines two strings into a new one"))
(fixture (expr . "(string<? \"a\" \"b\")") (expected . "t") (tier . 2) (axioms) (note . "PLAN.md item 15 — the one Rust primitive the persistent-map design needed; ordering, not just equality, can't be derived from string-first/string-rest/eq alone"))
(fixture (expr . "(string<? \"b\" \"a\")") (expected . "()") (tier . 2) (axioms))
(fixture (expr . "(map-get \"a\" (map-insert \"a\" 1 map-empty))") (expected . "(1)") (tier . 3) (axioms G5) (note . "PLAN.md item 15 — lib/persistent-map.my, an AVL-balanced persistent tree built on cons/car/cdr alone, no mutation; map-get's \"maybe\" shape (() absent, (value) present) avoids confusing a stored () with not-found"))
