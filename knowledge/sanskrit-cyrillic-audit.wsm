(sanskrit-cyrillic-audit
  (note "Cross-reference audit: new SOUND_ID registry ↔ UPC-8 prototype ↔ phoneme ledger. All statuses provisional pending owner decision.")
  (provenance
    (upc8-source "shiva-sutras/prototype/upc8.py")
    (ledger-source "shiva-sutras/extensions/ukrainian-claude-sarvam.yaml")
    (canon-source "shiva-sutras/ksetra/canon/siva-sutras.yaml"))

  ;; ====================================================================
  ;; STATUS VOCABULARY
  ;; ====================================================================
  (status-vocabulary
    (green "UPC-8/ledger well-aligned with new SOUND_ID model")
    (yellow "near/system-equivalent — needs identity decision")
    (red "UPC-8 byte-centric design conflates identity & representation")
    (open "no UPC-8/ledger precedent — new SOUND_ID territory")
    (unresolved-glyph "Cyrillic glyph candidate not yet selected"))

  ;; ====================================================================
  ;; AUDIT ENTRIES — VOWELS
  ;; ====================================================================
  (audit-entry
    (sound-id SA_A)
    (iast "a")
    (devanagari "अ")
    (upc8-canon 0x00)
    (upc8-canon-ref "SS-01:1")
    (upc8-ua-shared none)
    (upc8-ua-new 0x33 "PH-UKR-a" "near-equivalent")
    (ledger PH-UKR-CS-a "segment-equivalent" "SS-01:1" "length role differs: Sanskrit contrastive, Ukrainian non-contrastive")
    (cyrillic-glyph "а")
    (cyrillic-status candidate)
    (audit-color yellow)
    (decision-needed "realization vs identity: UA а ≈ SA_A but length role differs; shared SOUND_ID candidate requires length-role analysis"))

  (audit-entry
    (sound-id SA_A_LONG)
    (iast "ā")
    (devanagari "आ")
    (upc8-canon none)
    (upc8-skt-ext 0x2A "PH-SKT-A" "a:" "dirgha of a")
    (upc8-ua-new none)
    (ledger none)
    (cyrillic-glyph "а̄")
    (cyrillic-status candidate)
    (audit-color green)
    (decision-needed none))

  (audit-entry
    (sound-id SA_I)
