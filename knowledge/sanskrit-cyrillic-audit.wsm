    (upc8-ua-new none)
    (ledger PH-UKR-CS-i "segment-equivalent" "SS-01:2" "length contrast differs: Sanskrit i/ī contrastive, Ukrainian non-contrastive")
    (cyrillic-glyph "и")
    (cyrillic-status candidate)
    (audit-color yellow)
    (decision-needed "shared SOUND_ID candidate strong: segment-equivalent + length role difference documented"))

  (audit-entry
