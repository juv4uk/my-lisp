; Curated frequently-used tools. A record is navigation, not permission to run
; the command. `risk` and `verify` tell an agent what must be checked afterward.
; Добірка часто вживаних інструментів. Запис є навігацією, а не дозволом на
; запуск. Поля `risk` і `verify` пояснюють потрібний доказ після команди.
(def *guard-script-directory*
  (quote
    ((tool
       (name oracle-check)
       (summary "Безпечна перевірка синтаксису WSM без виконання · Parse-only WSM preflight without evaluation")
       (path "target/release/my-lisp")
       (invoke "/home/agents/GitHub/my-lisp/target/release/my-lisp --oracle-check <file|->")
       (risk read-only)
       (verify (exit-0-valid exit-2-structured-error rerun-after-edit)))
     (tool
       (name oracle-local-release)
       (summary "Запустити локальний release Oracle · Start the local release Oracle")
       (path "scripts/start-local-oracle-release.sh")
       (invoke "bash /home/agents/GitHub/my-lisp/scripts/start-local-oracle-release.sh")
       (risk local-service)
       (verify (loopback-listener release-executable contract-version kernel-utc-probe probe pid-metadata)))
     (tool
       (name oracle-local-release-stop)
