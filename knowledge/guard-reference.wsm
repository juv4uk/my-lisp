; Guard reference bureau / Довідкове бюро Guard
;
; One topic points to authoritative sources, the canonical workflow, and the
; evidence that proves completion. This is navigation knowledge, not a copy of
; those contracts. Paths are repository-relative unless prefixed with ../.
;
; Одна тема вказує на авторитетні джерела, штатний workflow і докази
; завершення. Це навігаційне знання, а не копія контрактів. Шляхи відносні до
; репозиторію, якщо не починаються з ../.

(def *guard-reference-directory*
  (quote
    ((reference
       (topic language-semantics)
       (summary "Meaning of WSM programs and conformance obligations")
       (authority (language-contract.my docs/language-core-axioms.md tests/fixtures/conformance.my))
       (how-to (read-contract run-conformance-fixtures))
       (verify (cargo-test-workspace evidence/README.md)))
     (reference
       (topic semantic-oracle)
       (summary "Expected semantic truth from the reference implementation")
       (authority (language-contract.my crates/my-lisp-cli/src/swarm.rs docs/guard-oracle-node-plan.md))
       (how-to (oracle-check oracle-eval oracle-help contract-version))
       (verify (oracle-result/1 source-digest contract-revision)))
     (reference
       (topic guard)
       (summary "Explain observed state against contract and guide the next safe step")
       (authority (lib/guard.wsm knowledge/guard-reference.wsm docs/guard-oracle-node-plan.md))
       (how-to (guard-reference guard-explain guard-how-to guard-verify))
       (verify (schema-guard/1 decision evidence-status evidence)))
     (reference
       (topic swarm-coordination)
       (summary "P2P journal, task claims, membership, replication, and readiness")
       (authority (docs/swarm-mesh-v2.md crates/swarm-node/src/main.rs tasks.my))
       (how-to (start-node wait-readiness join sync-tasks claim-task complete-task))
       (verify (metrics list-members list-task-state journal-event)))
     (reference
       (topic swarm-node-startup)
       (summary "Start exactly one process per persistent identity tree without silent defaults or pre-bind state mutation")
       (authority (docs/swarm-mesh-v2.md docs/swarm-remote-access.md crates/swarm-node/src/main.rs packaging/systemd/swarm-node@.service))
       (how-to (choose-stable-node-id choose-unique-absolute-data-dir choose-auto-sync-or-explicit-opt-out bind acquire-state-lock open-identity-and-journal verify-readiness))
       (verify (exclusive-data-dir-lock unchanged-identity-on-failed-spawn explicit-task-sync-choice metrics)))
     (reference
       (topic task-materialization)
       (summary "Move durable tasks.my definitions into journal facts and derived projection")
       (authority (tasks.my docs/swarm-mesh-v2.md crates/swarm-node/src/tasks_file.rs))
       (how-to (edit-tasks.my auto-sync-or-sync-tasks verify-projection verify-peer-convergence))
       (verify (task-definition journal-event list-task-state)))
     (reference
       (topic agent-messaging)
       (summary "Direct messages and completion broadcasts: durable inbox admission is separate from live-runtime wakeup; stale OpenCode sessions require re-registration")
       (authority (../ecosystem/docs/AGENT-DIRECT-MESSAGING.md ../ecosystem/scripts/agent-send))
       (how-to (start-opencode-serve register-live-session send-direct broadcast-completion read-inbox acknowledge-inbox))
       (verify (durable-inbox-entry wakeup-result session-id-not-unknown commit-sha)))
     (reference
       (topic claim-complete-broadcast)
       (summary "Task claims and completions are visible to the whole agent team; completion identifies the actual pushed revision")
       (authority (../ecosystem/AGENTS.md ../ecosystem/docs/AGENT-DIRECT-MESSAGING.md ../ecosystem/plans/tasks.my))
       (how-to (claim-task broadcast-claim do-work commit push-find-ci-run-wait-for-completion-read-failure-logs complete-task broadcast-completion-read-bus))
       (verify (task-state claim-event commit-sha pushed-confirmed matching-ci-run final-ci-status completion-event)))
     (reference
       (topic synchronized-commit-window)
       (summary "Freeze commit/push activity before synchronization, complete the sync, record drift, then reopen the window")
       (authority (lib/guard.wsm ../ecosystem/docs/AGENT-DIRECT-MESSAGING.md ../ecosystem/plans/ECOSYSTEM-GUARD-ORACLE-ROADMAP.md))
       (how-to (announce-freeze stop-commit-and-push synchronize inspect-build-logs-record-drift reopen-commits))
       (verify (freeze-observed sync-complete drift-record commit-window-reopened)))
     (reference
       (topic working-tree-hygiene)
       (summary "Explain every uncommitted change before deciding whether to include, preserve, or escalate it")
       (authority (../ecosystem/AGENTS.md ../ecosystem/docs/AGENT-RESOURCE-POLICY.md))
       (how-to (git-status inspect-diff-check-generated-artifacts-check-agent-history-commit-scoped-files))
       (verify (origin-identified or-unknown-with-checks no-unexplained-diff)))
     (reference
       (topic unknown-routing)
       (summary "UNKNOWN is a useful epistemic result with an explicit route, not an implicit rejection")
       (authority (../ecosystem/AGENTS.md ../ecosystem/plans/ECOSYSTEM-GUARD-ORACLE-ROADMAP.md))
       (how-to (ask-agent-for-local-facts ask-owner-for-authority-intent-license research-web-for-current-external-facts))
       (verify (route-recorded source-or-question-preserved no-silent-reject)))
     (reference
       (topic oracle-usage)
       (summary "Choose the narrowest Oracle operation: parse-only check, evaluation, diagnosis, or contract inspection")
       (authority (crates/my-lisp-cli/src/main.rs crates/my-lisp-cli/src/swarm.rs docs/guard-oracle-node-plan.md))
       (how-to (oracle-check-for-syntax oracle-eval-for-semantics diagnose-for-errors contract-version-for-revision))
       (verify (operation-recorded parse-vs-eval-distinguished structured-result)))
     (reference
       (topic runtime-selection)
       (summary "Select the wakeup transport from the registered agent runtime; durable inbox remains the shared fallback")
       (authority (../ecosystem/docs/AGENT-DIRECT-MESSAGING.md ../ecosystem/scripts/agent-send ../ecosystem/.agents/sessions.json))
       (how-to (inspect-agent-send-list register-live-runtime use-runtime-adapter read-inbox-on-wakeup-failure))
       (verify (runtime-matches-process session-id-valid inbox-admitted wakeup-result-recorded)))
     (reference
       (topic resource-preflight)
       (summary "Check load, memory, disk, and GPU before expensive or long-running work and keep commands bounded")
       (authority (../ecosystem/docs/AGENT-RESOURCE-POLICY.md ../ecosystem/scripts/preflight.sh))
       (how-to (run-preflight choose-bounded-command-set-timeout-stop-on-overload))
       (verify (preflight-result timeout-set workload-class-recorded no-unbounded-job)))
     (reference
       (topic evidence)
       (summary "Record claims at the strength actually earned by tests and artifacts")
       (authority (evidence/README.md docs/agent-doctrine.md))
       (how-to (classify-evidence record-command record-revision record-result))
       (verify (artifact commit-sha reproducible-command)))
     (reference
       (topic guix)
       (summary "Reproducible environments, witnesses, relocatable packs, agent capsules, substitutes, Home, and VM images")
       (authority (../ecosystem/docs/VIVEKA-FINDINGS-2026-08-24.md manifest.scm channels.scm guix.scm evidence/GUIX-WITNESS-01))
       (how-to (choose-guix-capability pin-channels use-pure-environment record-provenance verify-independent-build))
       (verify (channels-revision manifest-digest derivation output-hash builder-identity)))
     (reference
       (topic documentation-map)
       (summary "Curated links into existing ecosystem documentation by operational question")
       (authority (../ecosystem/docs/GUARD-REFERENCE-DIRECTORY.md))
       (how-to (choose-topic follow-authority-link avoid-duplicate-prose))
       (verify (linked-file-exists lifecycle-status-checked)))
     (reference
       (topic wsm-lisp-filesystem)
       (summary "Experimental immutable content-addressed filesystem model for the WSM Lisp machine")
       (authority (lib/lisp-fs.my lib/content-store.my tests/fixtures/lisp-fs-conformance.my crates/my-lisp/tests/content_store.rs))
       (how-to (fs-empty fs-write fs-read fs-list fs-contains? retain-old-root))
       (verify (fs-conformance-fixture immutable-root old-value not-found stored-nil logical-revision ci-run)))
     (reference
       (topic reference-learning)
       (summary "Persist a useful answer missing from the directory as a reviewable candidate for future agents")
       (authority (../ecosystem/knowledge/guard-reference-inbox.mylog ../ecosystem/docs/GUARD-REFERENCE-DIRECTORY.md crates/my-lisp-cli/src/bin/guard-reference.rs))
       (how-to (search-directory choose-unknown-route collect-source-and-evidence append-pending-review review promote-or-reject))
       (verify (candidate-record provenance review-status curated-entry-or-rejection)))
     (reference
       (topic licenses)
       (summary "Decide whether third-party code or data may enter an ecosystem repository")
       (authority (../ecosystem/docs/LICENSE-MATRIX.md))
       (how-to (check-license record-notice ask-owner-if-unresolved))
       (verify (license-entry notice provenance)))
     (reference
       (topic owner-context)
       (summary "Owner preferences, pace, identity, and durable architectural intent")
       (authority (../ecosystem/memory/OWNER-PROFILE.md))
       (how-to (read-before-work preserve-owner-wording))
       (verify (owner-profile-current))))))

; Curated frequently-used tools. A record is navigation, not permission to run
; the command. `risk` and `verify` tell an agent what must be checked afterward.
; Добірка часто вживаних інструментів. Запис є навігацією, а не дозволом на
; запуск. Поля `risk` і `verify` пояснюють потрібний доказ після команди.
(def *guard-script-directory*
  (quote
    ((tool
       (name oracle-check)
       (summary "Безпечна перевірка синтаксису WSM без виконання · Parse-only WSM preflight without evaluation")
       (path "target/debug/my-lisp")
       (invoke "/home/agents/GitHub/my-lisp/target/debug/my-lisp --oracle-check <file|->")
       (risk read-only)
       (verify (exit-0-valid exit-2-structured-error rerun-after-edit)))
     (tool
       (name guard-reference)
       (summary "Зберегти нову відповідь як pending-review candidate · Preserve a new answer as a review candidate")
       (path "target/debug/guard-reference")
       (invoke "/home/agents/GitHub/my-lisp/target/debug/guard-reference propose --inbox ABS --topic T --question Q --answer A --source S --route ROUTE --evidence E")
       (risk append-only)
       (verify (candidate-record status-pending-review provenance)))
     (tool
       (name agent-send)
       (summary "Довговічне повідомлення агенту з окремим wakeup · Durable agent message followed by a separate wakeup")
       (path "../ecosystem/scripts/agent-send")
       (invoke "/home/agents/ecosystem/scripts/agent-send send --from AGENT --to TARGET --kind KIND MESSAGE")
       (risk writes-coordination-log)
       (verify (admitted inbox-id wakeup-result)))
     (tool
       (name agent-inbox)
       (summary "Прочитати й підтвердити durable inbox · Read and acknowledge the durable inbox")
       (path "../ecosystem/scripts/agent-inbox")
       (invoke "/home/agents/ecosystem/scripts/agent-inbox read --agent AGENT; /home/agents/ecosystem/scripts/agent-inbox ack --agent AGENT --message ID")
       (risk updates-ack-status)
       (verify (message-id acknowledged)))
     (tool
       (name resource-preflight)
       (summary "Перевірити load, RAM, disk і GPU перед важкою роботою · Check load, RAM, disk, and GPU before heavy work")
       (path "../ecosystem/scripts/preflight.sh")
       (invoke "bash /home/agents/ecosystem/scripts/preflight.sh [max-load]")
       (risk read-only)
       (verify (exit-0-go exit-1-wait)))
     (tool
       (name bilingual-docs-check)
       (summary "Перевірити український відповідник змінених людських документів · Check Ukrainian coverage for changed human documentation")
       (path "../ecosystem/scripts/check-bilingual-docs")
       (invoke "/home/agents/ecosystem/scripts/check-bilingual-docs [files...]")
       (risk read-only)
       (verify (exit-0-covered english-only-report)))
     (tool
       (name version-drift-check)
       (summary "Знайти cross-repo розбіжності версій контрактів · Detect cross-repository contract-version drift")
       (path "../ecosystem/scripts/check-cross-repo-version-drift.py")
       (invoke "python3 /home/agents/ecosystem/scripts/check-cross-repo-version-drift.py --root /home/agents/GitHub")
       (risk read-only)
       (verify (exit-0-no-drift drift-rows-reviewed)))
     (tool
       (name duplicate-task-check)
       (summary "Знайти лише кандидатів на дублікати task IDs · Find advisory near-duplicate task candidates")
       (path "../ecosystem/scripts/check-near-duplicate-task-ids.py")
       (invoke "python3 /home/agents/ecosystem/scripts/check-near-duplicate-task-ids.py [task-state-dump]")
       (risk read-only-advisory)
       (verify (candidates-domain-reviewed no-auto-merge)))
     (tool
       (name conformance-check)
       (summary "Прогнати незалежного TCP witness мовного контракту · Run the independent TCP language-contract witness")
       (path "../ecosystem/scripts/conformance-check.py")
       (invoke "python3 /home/agents/ecosystem/scripts/conformance-check.py [host:port]")
       (risk bounded-test-run)
       (verify (oracle-revision fixture-count exit-status))))))

(def guard-script-find
  (lambda (name tools)
    (cond
      ((atom tools) (quote ()))
      ((eq (guard-reference-field (quote name) (car tools)) name) (car tools))
      (t (guard-script-find name (cdr tools))))))

(def guard-script
  (lambda (name)
    (let ((tool (guard-script-find name *guard-script-directory*)))
      (cond
        ((atom tool)
         (list
           (quote tool-missing)
           (list (quote name) name)
           (list (quote decision) (quote unknown))
           (list (quote unknown-routes) (guard-unknown-routes))))
        (t tool)))))

(def guard-scripts
  (lambda (tools)
    (cond
      ((atom tools) (quote ()))
      (t (cons (guard-reference-field (quote name) (car tools))
               (guard-scripts (cdr tools)))))))

(def guard-reference-find
  (lambda (topic references)
    (cond
      ((atom references) (quote ()))
      ((eq (guard-reference-field (quote topic) (car references)) topic)
       (car references))
      (t (guard-reference-find topic (cdr references))))))

(def guard-reference
  (lambda (topic)
    (let ((reference (guard-reference-find topic *guard-reference-directory*)))
      (cond
        ((atom reference)
         (list
           (quote reference-missing)
           (list (quote schema) (quote guard-reference/1))
           (list (quote topic) topic)
           (list (quote decision) (quote unknown))
           (list (quote evidence-status) (quote unresolved))
           (list (quote guidance) (quote choose-unknown-route))
           (list (quote unknown-routes) (guard-unknown-routes))))
        (t reference)))))

(def guard-explain
  (lambda (topic)
    (guard-reference-field (quote summary) (guard-reference topic))))

(def guard-how-to
  (lambda (topic)
    (guard-reference-field (quote how-to) (guard-reference topic))))

(def guard-authority
  (lambda (topic)
    (guard-reference-field (quote authority) (guard-reference topic))))

(def guard-verify
  (lambda (topic)
    (guard-reference-field (quote verify) (guard-reference topic))))

(def guard-topics
  (lambda (references)
    (cond
      ((atom references) (quote ()))
      (t
       (cons
         (guard-reference-field (quote topic) (car references))
         (guard-topics (cdr references)))))))
