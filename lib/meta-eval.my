; Metacircular evaluator: my-eval interprets my-lisp source as Lisp data.
;
; The important ownership boundary in this version is contract 2.1:
; ordinary primitive names are no longer recognized by a head-symbol dispatch
; inside my-eval. They resolve through the metacircular environment as
; first-class `(primitive name)` values. Therefore lexical bindings can
; shadow `+`, `car`, `eq`, etc. using the same lookup rule as any other name.
;
; Only syntax-only forms remain syntax dispatch here: quote, cond, lambda.
; The actual primitive operation is still supplied by the native substrate;
; this evaluator owns name resolution, lexical shadowing, application shape,
; macro expansion, closure environments, chained comparison policy,
; self-recursive and finite mutually recursive top-level function binding,
; variadic/dotted lambda parameter binding, and named failure observations for
; unresolved names, non-callable values, and lambda/macro arity mismatch.
;
; This remains an explicit self-hosting witness, not the always-loaded runtime.
; Full named-error parity and arbitrary later-binding visibility are still known
; gaps and must not be claimed as complete self-hosting.

(def my-primitive
  (lambda (name)
    (list (quote primitive) name)))

(def my-error
  (lambda (kind detail)
    (list (quote error) kind detail)))

; Root primitive meanings are represented as values, not as special cases in
; expression-head dispatch. An unbound non-primitive atom remains itself;
; this preserves the existing metacircular self-evaluation convention for
; numbers, strings, t and currently-unclassified symbols.
(def my-default-binding
  (lambda (name)
    (cond
      ((eq name (quote atom)) (my-primitive (quote atom)))
      ((eq name (quote eq))   (my-primitive (quote eq)))
      ((eq name (quote car))  (my-primitive (quote car)))
      ((eq name (quote cdr))  (my-primitive (quote cdr)))
      ((eq name (quote cons)) (my-primitive (quote cons)))
      ((eq name (quote +))    (my-primitive (quote +)))
      ((eq name (quote -))    (my-primitive (quote -)))
      ((eq name (quote *))    (my-primitive (quote *)))
      ((eq name (quote <))    (my-primitive (quote <)))
      ((eq name (quote =))    (my-primitive (quote =)))
      ((eq name (quote >))    (my-primitive (quote >)))
      (t name))))

(def env-lookup
  (lambda (name env)
    (cond
      ((atom env) (my-default-binding name))
      ((eq (car (car env)) name) (cdr (car env)))
      (t (env-lookup name (cdr env))))))

(def env-bound?
  (lambda (name env)
    (cond
      ((atom env) (quote ()))
      ((eq (car (car env)) name) t)
      (t (env-bound? name (cdr env))))))

(def my-primitive?
  (lambda (value)
    (cond
      ((atom value) (quote ()))
      (t (eq (car value) (quote primitive))))))

; UnknownSymbol belongs to name resolution, not application. A symbol produced
; as a value (for example by quote) is not an unresolved lookup and therefore
; must later fail as not-callable/Type if placed in operator position.
;
; `symbol?` itself is language-owned in core.my, derived without a Rust builtin,
; so this distinction adds no primitive to the closed Canon.
(def my-unresolved-name?
  (lambda (name env)
    (cond
      ((symbol? name)
       (cond
         ((eq name t) (quote ()))
         ((env-bound? name env) (quote ()))
         ((my-primitive? (my-default-binding name)) (quote ()))
         (t t)))
      (t (quote ())))))

(def my-macro?
  (lambda (value)
    (cond
      ((atom value) (quote ()))
      (t (eq (car value) (quote macro))))))

(def my-closure?
  (lambda (value)
    (cond
      ((atom value) (quote ()))
      (t (eq (car value) (quote closure))))))

; A recursive closure is finite Lisp data. It does not require a cyclic host
; Environment. At call time my-apply reconstructs the one self-binding that
; the function needs, then ordinary parameter bindings are placed in front of
; it so lexical parameters still shadow the function name when appropriate.
;
; Shape:
;   (recursive-closure name params body captured-env)
(def my-recursive-closure?
  (lambda (value)
    (cond
      ((atom value) (quote ()))
      (t (eq (car value) (quote recursive-closure))))))

; A mutually-recursive group is also finite Lisp data. Every member stores the
; same raw group and captured outer environment; my-apply reconstructs the
; group's bindings at call time rather than relying on a cyclic host object.
;
; Shape:
;   (recursive-group-closure name params body group captured-env)
(def my-group-closure?
  (lambda (value)
    (cond
      ((atom value) (quote ()))
      (t (eq (car value) (quote recursive-group-closure))))))

(def my-lambda-form?
  (lambda (form)
    (cond
      ((atom form) (quote ()))
      ((atom (car form)) (eq (car form) (quote lambda)))
      (t (quote ())))))

(def my-lambda-def-form?
  (lambda (form)
    (cond
      ((atom form) (quote ()))
      ((eq (car form) (quote def))
       (my-lambda-form? (third form)))
      (t (quote ())))))

(def my-fourth
  (lambda (values)
    (car (cdr (cdr (cdr values))))))

(def my-fifth
  (lambda (values)
    (car (cdr (cdr (cdr (cdr values)))))))

(def my-sixth
  (lambda (values)
    (car (cdr (cdr (cdr (cdr (cdr values))))))))

(def my-compare-two
  (lambda (operator left right)
    (cond
      ((eq operator (quote <)) (< left right))
      ((eq operator (quote =)) (= left right))
      ((eq operator (quote >)) (> left right))
      (t (quote ())))))

; Chained comparison semantics are Lisp-owned: values arrive already
; evaluated, adjacent pairs are compared left-to-right, and evaluation stops
; at the first false pair.
(def my-compare-chain
  (lambda (operator values)
    (cond
      ((atom (cdr values)) t)
      ((my-compare-two operator (car values) (second values))
       (my-compare-chain operator (cdr values)))
      (t (quote ())))))

; Primitive *identity* is a Lisp value. This function is the narrow bridge
; from that identity to the admitted native operation mechanism.
(def my-apply-primitive
  (lambda (name args)
    (cond
      ((eq name (quote atom)) (atom (car args)))
      ((eq name (quote eq))   (eq (car args) (second args)))
      ((eq name (quote car))  (car (car args)))
      ((eq name (quote cdr))  (cdr (car args)))
      ((eq name (quote cons)) (cons (car args) (second args)))
      ((eq name (quote +))    (+ (car args) (second args)))
      ((eq name (quote -))    (- (car args) (second args)))
      ((eq name (quote *))    (* (car args) (second args)))
      ((eq name (quote <))    (my-compare-chain (quote <) args))
      ((eq name (quote =))    (my-compare-chain (quote =) args))
      ((eq name (quote >))    (my-compare-chain (quote >) args))
      (t (list (quote unknown-primitive) name)))))

; Lambda-list arity is derivable from Lisp list structure itself:
;   (x y)        -> exact 2
;   (x y . rest) -> at least 2
;   args         -> at least 0
; No host metadata is required.
(def my-fixed-param-count
  (lambda (params)
    (cond
      ((atom params) 0)
      (t (+ 1 (my-fixed-param-count (cdr params)))))))

(def my-rest-param?
  (lambda (params)
    (cond
      ((atom params)
       (cond
         ((eq params (quote ())) (quote ()))
         (t t)))
      (t (my-rest-param? (cdr params))))))

(def my-arity-ok?
  (lambda (params args)
    (let ((fixed (my-fixed-param-count params))
          (received (length args)))
      (cond
        ((my-rest-param? params)
         (cond
           ((< received fixed) (quote ()))
           (t t)))
        (t (= received fixed))))))

(def my-arity-detail
  (lambda (params args)
    (let ((fixed (my-fixed-param-count params))
          (received (length args)))
      (list
        (quote expected)
        (cond
          ((my-rest-param? params) (list (quote at-least) fixed))
          (t (list (quote exact) fixed)))
        (quote received)
        received))))

(def my-arity-error
  (lambda (params args)
    (my-error (quote arity) (my-arity-detail params args))))

; Parameter binding owns only the successful path. Arity is checked by
; application before this function is entered.
(def bind-params
  (lambda (params args env)
    (cond
      ((atom params)
       (cond
         ((eq params (quote ())) env)
         (t (cons (cons params args) env))))
      (t (cons (cons (car params) (car args))
               (bind-params (cdr params) (cdr args) env))))))

(def my-eval-list
  (lambda (exprs env)
    (cond
      ((atom exprs) (quote ()))
      (t (cons (my-eval (car exprs) env)
               (my-eval-list (cdr exprs) env))))))

(def my-eval-body
  (lambda (body env)
    (cond
      ((atom (cdr body)) (my-eval (car body) env))
      (t ((lambda ()
            (my-eval (car body) env)
            (my-eval-body (cdr body) env)))))))

(def my-eval-cond
  (lambda (clauses env)
    (cond
      ((atom clauses) (quote ()))
      ((my-eval (car (car clauses)) env)
       (my-eval (second (car clauses)) env))
      (t (my-eval-cond (cdr clauses) env)))))

(def my-take-lambda-def-group
  (lambda (forms)
    (cond
      ((atom forms) (quote ()))
      ((my-lambda-def-form? (car forms))
       (cons (car forms)
             (my-take-lambda-def-group (cdr forms))))
      (t (quote ())))))

(def my-drop-lambda-def-group
  (lambda (forms)
    (cond
      ((atom forms) (quote ()))
      ((my-lambda-def-form? (car forms))
       (my-drop-lambda-def-group (cdr forms)))
      (t forms))))

(def my-group-closure-from-def
  (lambda (form group captured-env)
    (let ((lambda-form (third form)))
      (list (quote recursive-group-closure)
            (second form)
            (second lambda-form)
            (cdr (cdr lambda-form))
            group
            captured-env))))

; Build onto the captured environment so later definitions in a contiguous
; top-level group appear earlier in the alist, matching same-frame overwrite
; order without requiring mutable or cyclic host environment state.
(def my-build-group-env-onto
  (lambda (forms group captured-env out)
    (cond
      ((atom forms) out)
      (t
       (let ((form (car forms)))
         (my-build-group-env-onto
           (cdr forms)
           group
           captured-env
           (cons
             (cons (second form)
                   (my-group-closure-from-def form group captured-env))
             out)))))))

(def my-build-group-env
  (lambda (group captured-env)
    (my-build-group-env-onto group group captured-env captured-env)))

(def my-apply
  (lambda (fn args)
    (cond
      ; Application owns only callability. UnknownSymbol has already been
      ; decided by the operator-name resolution path in my-eval.
      ((atom fn) (my-error (quote not-callable) fn))
      ((my-primitive? fn)
       (my-apply-primitive (second fn) args))
      ((my-closure? fn)
       (cond
         ((my-arity-ok? (second fn) args)
          (my-eval-body
            (third fn)
            (bind-params
              (second fn)
              args
              (my-fourth fn))))
         (t (my-arity-error (second fn) args))))
      ((my-recursive-closure? fn)
       (cond
         ((my-arity-ok? (third fn) args)
          (let ((self-env
                  (cons (cons (second fn) fn)
                        (my-fifth fn))))
            (my-eval-body
              (my-fourth fn)
              (bind-params
                (third fn)
                args
                self-env))))
         (t (my-arity-error (third fn) args))))
      ((my-group-closure? fn)
       (cond
         ((my-arity-ok? (third fn) args)
          (let ((group-env
                  (my-build-group-env (my-fifth fn) (my-sixth fn))))
            (my-eval-body
              (my-fourth fn)
              (bind-params
                (third fn)
                args
                group-env))))
         (t (my-arity-error (third fn) args))))
      ((my-macro? fn)
       (cond
         ((my-arity-ok? (second fn) args)
          (my-eval-body
            (third fn)
            (bind-params
              (second fn)
              args
              (my-fourth fn))))
         (t (my-arity-error (second fn) args))))
      (t (my-error (quote not-callable) fn)))))

(def my-eval
  (lambda (expr env)
    (cond
      ((atom expr) (env-lookup expr env))
      ((atom (car expr))
       (cond
         ; Syntax-only forms remain outside the ordinary value namespace.
         ((eq (car expr) (quote quote)) (second expr))
         ((eq (car expr) (quote cond)) (my-eval-cond (cdr expr) env))
         ((eq (car expr) (quote lambda))
          (list (quote closure) (second expr) (cdr (cdr expr)) env))
         ; UnknownSymbol is a lookup observation, not a property of the value
         ; that eventually reaches apply. This preserves the distinction between
         ; `(missing)` and `((quote missing))`.
         ((my-unresolved-name? (car expr) env)
          (my-error (quote unbound-symbol) (car expr)))
         ; Every resolved ordinary name uses the same value-level apply path.
         (t
          (let ((fn (my-eval (car expr) env)))
            (cond
              ; Macro receives raw forms, then its expansion is evaluated.
              ((my-macro? fn)
               (my-eval (my-apply fn (cdr expr)) env))
              (t
               (my-apply fn (my-eval-list (cdr expr) env))))))))
      ; Computed operator position uses the same value-level apply path; a symbol
      ; produced here is already a value and therefore fails as not-callable.
      (t
       (my-apply
         (my-eval (car expr) env)
         (my-eval-list (cdr expr) env))))))

; Top-level sequencing. `def` and `defmacro` return `(new-env . value)` so
; the immutable alist environment can be threaded explicitly to the next form.
;
; `my-eval-program` recognizes each contiguous top-level lambda-definition
; block as one finite recursive group, so its members can refer to one another
; without a cyclic host Environment. A direct single-form `my-eval-top-form`
; keeps the smaller recursive-closure representation for self recursion.
(def my-eval-top-form
  (lambda (form env)
    (cond
      ((atom form) (cons env (my-eval form env)))
      ((eq (car form) (quote def))
       (let ((value-form (third form)))
         (cond
           ((my-lambda-form? value-form)
            (let ((value
                    (list (quote recursive-closure)
                          (second form)
                          (second value-form)
                          (cdr (cdr value-form))
                          env)))
              (cons (cons (cons (second form) value) env) value)))
           (t
            (let ((value (my-eval value-form env)))
              (cons (cons (cons (second form) value) env) value))))))
      ((eq (car form) (quote defmacro))
       (let ((macro-val
               (list (quote macro)
                     (third form)
                     (cdr (cdr (cdr form)))
                     env)))
         (cons (cons (cons (second form) macro-val) env) macro-val)))
      (t (cons env (my-eval form env))))))

(def my-eval-program
  (lambda (forms env)
    (cond
      ((my-lambda-def-form? (car forms))
       (let ((group (my-take-lambda-def-group forms)))
         (let ((rest (my-drop-lambda-def-group forms)))
           (let ((group-env (my-build-group-env group env)))
             (cond
               ((atom rest)
                (cons group-env (cdr (car group-env))))
               (t (my-eval-program rest group-env)))))))
      (t
       (let ((result (my-eval-top-form (car forms) env)))
         (cond
           ((atom (cdr forms)) result)
           (t (my-eval-program (cdr forms) (car result)))))))))