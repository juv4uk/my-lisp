; Metacircular evaluator: my-eval interprets my-lisp source as Lisp data.
;
; The important ownership boundary in this version is contract 2.1:
; ordinary primitive names are no longer recognized by a head-symbol dispatch
; inside my-eval.  They resolve through the metacircular environment as
; first-class `(primitive name)` values.  Therefore lexical bindings can
; shadow `+`, `car`, `eq`, etc. using the same lookup rule as any other name.
;
; Only syntax-only forms remain syntax dispatch here: quote, cond, lambda.
; The actual primitive operation is still supplied by the native substrate;
; this evaluator owns name resolution, lexical shadowing, application shape,
; macro expansion, closure environments and chained comparison policy.
;
; This remains an explicit self-hosting witness, not the always-loaded runtime.
; Named-error parity, variadic/dotted lambda lists and recursive top-level def
; are still known gaps and must not be claimed as complete self-hosting.

(def my-primitive
  (lambda (name)
    (list (quote primitive) name)))

; Root primitive meanings are represented as values, not as special cases in
; expression-head dispatch.  An unbound non-primitive atom remains itself;
; this preserves the existing metacircular self-evaluation convention for
; numbers, strings, t and currently-unclassified symbols.
(def my-default-binding
  (lambda (name)
    (cond
      ((eq name (quote atom)) (my-primitive (quote atom)))
      ((eq name (quote eq))   (my-primitive (quote eq)))
      ((eq name (quote car))  (my-primitive (quote car)))
      ((eq name (quote cdr))  (my-primitive (quote cdr)))
      ((eq name (quote cons)) (my-primitive (quote cons)))
      ((eq name (quote +))    (my-primitive (quote +)))
      ((eq name (quote -))    (my-primitive (quote -)))
      ((eq name (quote *))    (my-primitive (quote *)))
      ((eq name (quote <))    (my-primitive (quote <)))
      ((eq name (quote =))    (my-primitive (quote =)))
      ((eq name (quote >))    (my-primitive (quote >)))
      (t name))))

(def env-lookup
  (lambda (name env)
    (cond
      ((atom env) (my-default-binding name))
      ((eq (car (car env)) name) (cdr (car env)))
      (t (env-lookup name (cdr env))))))

(def my-primitive?
  (lambda (value)
    (cond
      ((atom value) (quote ()))
      (t (eq (car value) (quote primitive))))))

(def my-macro?
  (lambda (value)
    (cond
      ((atom value) (quote ()))
      (t (eq (car value) (quote macro))))))

(def my-closure?
  (lambda (value)
    (cond
      ((atom value) (quote ()))
      (t (eq (car value) (quote closure))))))

(def my-compare-two
  (lambda (operator left right)
    (cond
      ((eq operator (quote <)) (< left right))
      ((eq operator (quote =)) (= left right))
      ((eq operator (quote >)) (> left right))
      (t (quote ())))))

; Chained comparison semantics are Lisp-owned: values arrive already
; evaluated, adjacent pairs are compared left-to-right, and evaluation stops
; at the first false pair.
(def my-compare-chain
  (lambda (operator values)
    (cond
      ((atom (cdr values)) t)
      ((my-compare-two operator (car values) (second values))
       (my-compare-chain operator (cdr values)))
      (t (quote ())))))

; Primitive *identity* is a Lisp value.  This function is the narrow bridge
; from that identity to the admitted native operation mechanism.
(def my-apply-primitive
  (lambda (name args)
    (cond
      ((eq name (quote atom)) (atom (car args)))
      ((eq name (quote eq))   (eq (car args) (second args)))
      ((eq name (quote car))  (car (car args)))
      ((eq name (quote cdr))  (cdr (car args)))
      ((eq name (quote cons)) (cons (car args) (second args)))
      ((eq name (quote +))    (+ (car args) (second args)))
      ((eq name (quote -))    (- (car args) (second args)))
      ((eq name (quote *))    (* (car args) (second args)))
      ((eq name (quote <))    (my-compare-chain (quote <) args))
      ((eq name (quote =))    (my-compare-chain (quote =) args))
      ((eq name (quote >))    (my-compare-chain (quote >) args))
      (t (list (quote unknown-primitive) name)))))

(def bind-params
  (lambda (params args env)
    (cond
      ((atom params) env)
      (t (cons (cons (car params) (car args))
               (bind-params (cdr params) (cdr args) env))))))

(def my-eval-list
  (lambda (exprs env)
    (cond
      ((atom exprs) (quote ()))
      (t (cons (my-eval (car exprs) env)
               (my-eval-list (cdr exprs) env))))))

(def my-eval-body
  (lambda (body env)
    (cond
      ((atom (cdr body)) (my-eval (car body) env))
      (t ((lambda ()
            (my-eval (car body) env)
            (my-eval-body (cdr body) env)))))))

(def my-eval-cond
  (lambda (clauses env)
    (cond
      ((atom clauses) (quote ()))
      ((my-eval (car (car clauses)) env)
       (my-eval (second (car clauses)) env))
      (t (my-eval-cond (cdr clauses) env)))))

(def my-apply
  (lambda (fn args)
    (cond
      ((atom fn) (list (quote not-callable) fn))
      ((my-primitive? fn)
       (my-apply-primitive (second fn) args))
      ((my-closure? fn)
       (my-eval-body
         (third fn)
         (bind-params
           (second fn)
           args
           (car (cdr (cdr (cdr fn)))))))
      ((my-macro? fn)
       (my-eval-body
         (third fn)
         (bind-params
           (second fn)
           args
           (car (cdr (cdr (cdr fn)))))))
      (t (list (quote not-callable) fn)))))

(def my-eval
  (lambda (expr env)
    (cond
      ((atom expr) (env-lookup expr env))
      ((atom (car expr))
       (cond
         ; Syntax-only forms remain outside the ordinary value namespace.
         ((eq (car expr) (quote quote)) (second expr))
         ((eq (car expr) (quote cond)) (my-eval-cond (cdr expr) env))
         ((eq (car expr) (quote lambda))
          (list (quote closure) (second expr) (cdr (cdr expr)) env))
         ; Every ordinary name is resolved through the environment first.
         (t
          (let ((fn (my-eval (car expr) env)))
            (cond
              ; Macro receives raw forms, then its expansion is evaluated.
              ((my-macro? fn)
               (my-eval (my-apply fn (cdr expr)) env))
              (t
               (my-apply fn (my-eval-list (cdr expr) env))))))))
      ; Computed operator position uses the same value-level apply path.
      (t
       (my-apply
         (my-eval (car expr) env)
         (my-eval-list (cdr expr) env))))))

; Top-level sequencing.  `def` and `defmacro` return `(new-env . value)` so
; the immutable alist environment can be threaded explicitly to the next form.
(def my-eval-top-form
  (lambda (form env)
    (cond
      ((atom form) (cons env (my-eval form env)))
      ((eq (car form) (quote def))
       (let ((value (my-eval (third form) env)))
         (cons (cons (cons (second form) value) env) value)))
      ((eq (car form) (quote defmacro))
       (let ((macro-val
               (list (quote macro)
                     (third form)
                     (cdr (cdr (cdr form)))
                     env)))
         (cons (cons (cons (second form) macro-val) env) macro-val)))
      (t (cons env (my-eval form env))))))

(def my-eval-program
  (lambda (forms env)
    (let ((result (my-eval-top-form (car forms) env)))
      (cond
        ((atom (cdr forms)) result)
        (t (my-eval-program (cdr forms) (car result)))))))
