; lib/macro.my — macro definition derived inside my-lisp.
; lib/macro.my — визначення макросів, виведене всередині my-lisp.
;
; This file is the executable reduction proof for DEFMACRO:
;
;   DEFMACRO = DEFINE + LAMBDA + MAKE_MACRO + list construction
;
; `make-macro` is the narrow host substrate Closure -> Macro. Everything
; that introduces a named macro is expressed here in the language itself.
;
; The canonical library binding owns the real surface name `defmacro`.
; Standard `Session` construction evaluates this file before user code, while
; a bare `Environment::root()` intentionally remains the smaller Rust kernel.

(define defmacro
  (make-macro
    (lambda (name params . body)
      (cons (quote define)
        (cons name
          (cons
            (cons (quote make-macro)
              (cons
                (cons (quote lambda)
                  (cons params body))
                (quote ())))
            (quote ())))))))

; Transitional proof name retained so older experiments keep working while
; callers migrate to the real language-owned surface above.
(define defmacro-derived defmacro)

; Historical DEF is compatibility syntax, not a necessary evaluator law.
; It expands to the canonical DEFINE form without evaluating NAME or VALUE
; during expansion.  Keeping the compatibility spelling in Lisp lets the
; evaluator shed a dedicated head-name branch while preserving ordinary
; definition semantics for bootstrapped sessions.
(defmacro def (name value)
  (cons (quote define)
    (cons name
      (cons value (quote ())))))
