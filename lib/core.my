; my-lisp bootstrap library: derived behavior belongs in the language itself.
; Bootstrap-бібліотека my-lisp: похідна поведінка належить самій мові.
; my-lisp-Bootstrap-Bibliothek: Abgeleitetes Verhalten gehört in die Sprache selbst.

(def identity (lambda (value) value))

(def not
  (lambda (value)
    (cond
      (value '())
      (t t))))

(def pair
  (lambda (left right)
    (cons left (cons right '()))))

(def second
  (lambda (values)
    (car (cdr values))))

(def third
  (lambda (values)
    (car (cdr (cdr values)))))

(def caar
  (lambda (values)
    (car (car values))))

(def cadr
  (lambda (values)
    (car (cdr values))))

(def length
  (lambda (values)
    (cond
      ((atom values) 0)
      (t (+ 1 (length (cdr values)))))))

(def reverse-onto
  (lambda (values acc)
    (cond
      ((atom values) acc)
      (t (reverse-onto (cdr values) (cons (car values) acc))))))

(def reverse
  (lambda (values)
    (reverse-onto values '())))

(def append
  (lambda (left right)
    (cond
      ((atom left) right)
      (t (cons (car left) (append (cdr left) right))))))

(def map
  (lambda (f values)
    (cond
      ((atom values) '())
      (t (cons (f (car values)) (map f (cdr values)))))))

(def filter
  (lambda (predicate values)
    (cond
      ((atom values) '())
      ((predicate (car values)) (cons (car values) (filter predicate (cdr values))))
      (t (filter predicate (cdr values))))))

(def reduce
  (lambda (f acc values)
    (cond
      ((atom values) acc)
      (t (reduce f (f acc (car values)) (cdr values))))))
