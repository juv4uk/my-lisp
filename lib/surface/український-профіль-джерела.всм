; Український профіль людського вихідного коду — ПІДГОТОВЧИЙ шар.
;
; Це НЕ semantic authority і НЕ заміна lib/surface/semantic-registry.wsm.
; Canon / numeric semantic ID лишається єдиною identity. Цей файл є лише
; staging-джерелом кандидатів для колонки `Повна українська` у спільній
; machine-readable таблиці функцій з ECO-CANON-1 / #75.
;
; Поле `чинна-назва` відбиває теперішню stable UK surface; друга назва —
; кандидат у колонку `Повна українська`. Після перенесення в Canon-таблицю
; цей файл не повинен ставати другою authority.
; Значення `—` означає: назву ще не обрано, не вгадувати її автоматично.
;
; Semantic IDs тут записані як числа лише для механічної перевірки через
; живий reader. Їхня авторитетна zero-padded форма живе тільки в
; semantic-registry.wsm.

(український-профіль-джерела/1
  (залежить-від
    (канон-таблиця-функцій issue-75)
    (український-source issue-77))

  (призначення
    (цільова-колонка повна-українська)
    (не-окрема-authority t)
    (semantic-id єдина-identity))

  (політика
    (основна-людська-мова українська)
    (основне-розширення ".всм")
    (повні-слова t)
    (програмістські-скорочення заборонені-за-замовчуванням)
    (кодування utf-8-nfc)
    (старі-розширення compatibility-only)
    (semantic-id єдина-identity))

  ; Міжнародні технічні позначення не треба насильно перекладати.
  ; Це allowlist, а не дозвіл створювати нові локальні скорочення.
  (дозволені-міжнародні-позначення
    (utf-8 abi api elf uefi x86_64 json http tcp udp))

  ; Перший seed — тільки те, що вже прямо випливає з owner directive
  ; або є очевидним розгортанням скорочення. Решта 140/140 назв проходять
  ; окремий змістовний огляд; цей файл не вгадує їх наперед.
  (назви
    ; Canon / necessary forms already satisfy the full-word rule.
    (1    "як-є"                         "як-є"                                      чинна)
    (10   "функція"                      "функція"                                   чинна)
    (11   "визначити"                    "визначити"                                 чинна)

    ; Owner explicitly prefers the readable operation words `плюс` / `мінус`.
    (104  "додати"                       "плюс"                                      кандидат-власника)
    (1001 "відняти"                      "мінус"                                     кандидат-власника)

    ; Existing abbreviations are readable today, but the new source policy
    ; asks for full words in canonical human-authored code.
    (1075 "монотонний-нс"                "монотонний-час-у-наносекундах"             кандидат-повної-назви)
    (1079 "поточний-всч"                 "поточний-всесвітній-координований-час"      кандидат-повної-назви)
    (1080 "всч-із-юнікс"                 "всесвітній-координований-час-із-юнікс-часу" кандидат-повної-назви)
    (1081 "юнікс-спостереження-у-всч"    "спостереження-юнікс-часу-у-всесвітній-координований-час" кандидат-повної-назви)
    (1083 "монотонний-мс"                "монотонний-час-у-мілісекундах"             кандидат-повної-назви)
    (1089 "минуло-нс"                    "минуло-наносекунд"                         кандидат-повної-назви)
    (1091 "дедлайн-через-нс"             "дедлайн-через-наносекунди"                 кандидат-повної-назви)

    ; Не вгадувати термін там, де потрібне окреме змістовне рішення.
    (1090 "дедлайн-від"                  —                                            потребує-огляду)))
