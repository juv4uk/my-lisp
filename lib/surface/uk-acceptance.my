;; Ukrainian-only acceptance program.
;; Українська приймальна програма.
;;
;; This program exercises the Ukrainian surface without using any English
;; builtin or form names.  Numeric literals, string literals, and punctuation
;; are naturally exempt.  Every operation — definition, lambda, arithmetic,
;; comparison, list processing, higher-order functions, strings, and time —
;; uses only Ukrainian vocabulary.
;;
;; Required surface: lib/surface/uk.my (loaded after core.my).
;; Addresses Issue #1 — Ukrainian Surface Coverage, task 11.
;;
;; Run: load core library + uk.my, then evaluate this file.

;; ═══════════════════════════════════════════════════════════════
;; 1. Визначення та функції (definition and lambda)
;; ═══════════════════════════════════════════════════════════════

(визначити квадрат
  (функція (x)
    (помножити x x)))

(визначити факторіал
  (функція (n)
    (за-умовою
      ((не-більше? n 1) 1)
      (інакше (помножити n (факторіал (відняти n 1)))))))

;; ═══════════════════════════════════════════════════════════════
;; 2. Арифметика та порівняння (arithmetic and comparisons)
;; ═══════════════════════════════════════════════════════════════

(визначити перевірка-арифметики
  (функція ()
    (за-умовою
      ((тотожне? (додати 2 3) 5) 'ок)
      (інакше 'помилка))))

;; ═══════════════════════════════════════════════════════════════
;; 3. Обробка списків (list processing)
;; ═══════════════════════════════════════════════════════════════

(визначити суму-списку
  (функція (lst)
    (за-умовою
      ((тотожне? lst (як-є ())) 0)
      (інакше (додати (перше lst) (суму-списку (решта lst)))))))

(визначити довжина-рекурсивно
  (функція (lst)
    (за-умовою
      ((тотожне? lst (як-є ())) 0)
      (інакше (додати 1 (довжина-рекурсивно (решта lst)))))))

;; ═══════════════════════════════════════════════════════════════
;; 4. Функції вищого порядку (higher-order functions)
;; ═══════════════════════════════════════════════════════════════

(визначити подвоїти-все
  (функція (lst)
    (відобразити (функція (x) (помножити x 2)) lst)))

(визначити лише-парні
  (функція (lst)
    (відсіяти
      (функція (x) (тотожне? (остача x 2) 0))
      lst)))

(визначити добуток-списку
  (функція (lst)
    (згорнути помножити lst)))

;; ═══════════════════════════════════════════════════════════════
;; 5. Рядки (strings)
;; ═══════════════════════════════════════════════════════════════

(визначити привітання
  (функція (ім'я)
    (зчепити "Привіт, " ім'я)))

;; ═══════════════════════════════════════════════════════════════
;; 6. Бібліотека поза core (time library)
;; ═══════════════════════════════════════════════════════════════

(визначити поточний-час
  (функція ()
    (unix-час-зараз)))

;; ═══════════════════════════════════════════════════════════════
;; 7. Приймальні тести (acceptance tests — self-checking)
;; ═══════════════════════════════════════════════════════════════

(визначити перевірити-все
  (функція ()
    (за-умовою
      ;; arithmetic
      ((не (тотожне? (квадрат 7) 49)) 'помилка-квадрат)
      ;; factorial
      ((не (тотожне? (факторіал 5) 120)) 'помилка-факторіал)
      ;; list recursion
      ((не (тотожне? (суму-списку (список 1 2 3 4 5)) 15)) 'помилка-сума)
      ((не (тотожне? (довжина-рекурсивно (список 'а 'б 'в)) 3)) 'помилка-довжина)
      ;; higher-order: map
      ((не (тотожне? (подвоїти-все (список 1 2 3)) (список 2 4 6))) 'помилка-подвоїти)
      ;; higher-order: filter
      ((не (однакові? (лише-парні (список 1 2 3 4 5 6)) (список 2 4 6))) 'помилка-парні)
      ;; higher-order: reduce
      ((не (тотожне? (добуток-списку (список 1 2 3 4)) 24)) 'помилка-добуток)
      ;; strings
      ((не (тотожне? (привітання "світе") "Привіт, світе")) 'помилка-привітання)
      ;; string predicate
      ((не (текст? "тест")) 'помилка-текст-предикат)
      ;; string length
      ((не (тотожне? (довжина-тексту "кіт") 3)) 'помилка-довжина-тексту)
      ;; comparison chain
      ((не (менше? 1 2)) 'помилка-менше)
      ((не (більше? 3 2)) 'помилка-більше)
      ((не (рівне? 4 4)) 'помилка-рівне)
      ;; all passed
      (інакше 'успіх))))

;; Run all tests
(перевірити-все)
