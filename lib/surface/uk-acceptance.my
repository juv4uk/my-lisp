;; Ukrainian-only acceptance program.
;; Українська приймальна програма.
;;
;; This program exercises the Ukrainian surface without using any English
;; builtin or form names.  Numeric literals, string literals, and punctuation
;; are naturally exempt.  Every operation — definition, lambda, arithmetic,
;; comparison, list processing, higher-order functions, strings, and time —
;; uses only Ukrainian vocabulary.
;;
;; Required surface: lib/surface/uk.my (loaded after core.my).
;; Addresses Issue #1 — Ukrainian Surface Coverage, task 11.
;;
;; Run: load core library + uk.my, then evaluate this file.

;; ═══════════════════════════════════════════════════════════════
;; 1. Визначення та функції (definition and lambda)
;; ═══════════════════════════════════════════════════════════════

(визначити квадрат
  (функція (x)
    (помножити x x)))

(визначити факторіал
  (функція (n)
    (за-умовою
      ((не-більше? n 1) 1)
      ((тотожне? 1 1) (помножити n (факторіал (відняти n 1)))))))

;; ═══════════════════════════════════════════════════════════════
;; 2. Арифметика та порівняння (arithmetic and comparisons)
;; ═══════════════════════════════════════════════════════════════

(визначити перевірка-арифметики
  (функція ()
    (за-умовою
      ((тотожне? (додати 2 3) 5) (як-є ок))
      ((тотожне? 1 1) (як-є помилка)))))

;; ═══════════════════════════════════════════════════════════════
;; 3. Обробка списків (list processing)
;; ═══════════════════════════════════════════════════════════════

(визначити суму-списку
  (функція (lst)
    (за-умовою
      ((атом? lst) 0)
      ((тотожне? 1 1) (додати (перше lst) (суму-списку (решта lst)))))))

(визначити довжина-рекурсивно
  (функція (lst)
    (за-умовою
      ((атом? lst) 0)
      ((тотожне? 1 1) (додати 1 (довжина-рекурсивно (решта lst)))))))

;; ═══════════════════════════════════════════════════════════════
;; 4. Функції вищого порядку (higher-order functions)
;; ═══════════════════════════════════════════════════════════════

(визначити подвоїти-все
  (функція (lst)
    (відобразити (функція (x) (помножити x 2)) lst)))

(визначити лише-парні
  (функція (lst)
    (відсіяти
      (функція (x) (тотожне? (остача x 2) 0))
      lst)))

(визначити добуток-списку
  (функція (lst)
    (згорнути помножити 1 lst)))

;; ═══════════════════════════════════════════════════════════════
;; 5. Рядки (strings)
;; ═══════════════════════════════════════════════════════════════

(визначити привітання
  (функція (ім'я)
    (зчепити "Привіт, " ім'я)))

;; ═══════════════════════════════════════════════════════════════
;; 6. Бібліотека поза core (time library)
;; ═══════════════════════════════════════════════════════════════

(визначити поточний-час
  (функція ()
    (unix-час-зараз)))

;; ═══════════════════════════════════════════════════════════════
;; 7. Приймальні тести (acceptance tests — self-checking)
;; ═══════════════════════════════════════════════════════════════

(визначити перевірити-все
  (функція ()
    (за-умовою
      ;; arithmetic
      ((хибне? (тотожне? (квадрат 7) 49)) (як-є помилка-квадрат))
      ;; factorial
      ((хибне? (тотожне? (факторіал 5) 120)) (як-є помилка-факторіал))
      ;; list recursion
      ((хибне? (тотожне? (суму-списку (список 1 2 3 4 5)) 15)) (як-є помилка-сума))
      ((хибне? (тотожне? (довжина-рекурсивно (список (як-є а) (як-є б) (як-є в))) 3)) (як-є помилка-довжина))
      ;; higher-order: map
      ((хибне? (однакові? (подвоїти-все (список 1 2 3)) (список 2 4 6))) (як-є помилка-подвоїти))
      ;; higher-order: filter
      ((хибне? (однакові? (лише-парні (список 1 2 3 4 5 6)) (список 2 4 6))) (як-є помилка-парні))
      ;; higher-order: reduce
      ((хибне? (тотожне? (добуток-списку (список 1 2 3 4)) 24)) (як-є помилка-добуток))
      ;; strings
      ((хибне? (однакові? (привітання "світе") "Привіт, світе")) (як-є помилка-привітання))
      ;; string predicate
      ((хибне? (текст? "тест")) (як-є помилка-текст-предикат))
      ;; string length
      ((хибне? (тотожне? (довжина-тексту "кіт") 3)) (як-є помилка-довжина-тексту))
      ;; comparison chain
      ((хибне? (менше? 1 2)) (як-є помилка-менше))
      ((хибне? (більше? 3 2)) (як-є помилка-більше))
      ((хибне? (рівне? 4 4)) (як-є помилка-рівне))
      ;; all passed
      ((тотожне? 1 1) (як-є успіх)))))

;; Run all tests
(перевірити-все)
