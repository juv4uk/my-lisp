; Машинно-читані метадані українського публічного API.
; Це документаційний індекс, а не семантична влада.
; Набір пар EN↔UK мусить точно збігатися зі stable-рядками uk-sa-coverage.wsm.

(uk-api-docs
  (schema uk-api-docs/1)
  (count 140)
  (kinds (form macro function predicate mutation value))
  (docs
    (doc canon quote як-є form "(як-є форма)" "Повертає форму як дані, не обчислюючи її.")
    (doc canon atom атом? predicate "(атом? значення)" "Питає, чи значення є атомом, тобто не парою.")
    (doc canon eq тотожне? predicate "(тотожне? ліве праве)" "Питає про канонічну тотожність двох атомарних значень.")
    (doc canon cons сполучити function "(сполучити голова хвіст)" "Створює пару з голови та хвоста.")
    (doc canon car перше function "(перше пара)" "Повертає голову пари.")
    (doc canon cdr решта function "(решта пара)" "Повертає хвіст пари.")
    (doc canon cond за-умовою form "(за-умовою (умова вираз) ...)" "Перевіряє гілки по черзі та обчислює вираз першої істинної умови.")
    (doc forms lambda функція form "(функція (параметри ...) тіло ...)" "Створює лексичне замикання з параметрами й тілом.")
    (doc forms define визначити form "(визначити ім'я значення)" "Створює або оновлює зв'язування імені у поточному середовищі.")
    (doc forms defmacro визначити-макрос macro "(визначити-макрос ім'я (параметри ...) тіло)" "Визначає макрос, що отримує необчислені форми аргументів.")
    (doc arithmetic + додати function "(додати число ...)" "Додає числа, зберігаючи точність exact-значень.")
    (doc arithmetic - відняти function "(відняти число ...)" "Віднімає наступні числа від першого.")
    (doc arithmetic * помножити function "(помножити число ...)" "Множить числа.")
    (doc arithmetic / поділити function "(поділити число дільник ...)" "Ділить і для exact-аргументів повертає точний раціональний результат.")
    (doc arithmetic abs модуль function "(модуль число)" "Повертає абсолютне значення числа.")
    (doc arithmetic min найменше function "(найменше число ...)" "Повертає найменше з переданих чисел.")
    (doc arithmetic max найбільше function "(найбільше число ...)" "Повертає найбільше з переданих чисел.")
    (doc arithmetic mod остача function "(остача число дільник)" "Повертає остачу від цілочисельного ділення.")
    (doc arithmetic quotient частка function "(частка число дільник)" "Повертає цілу частку від ділення.")
    (doc arithmetic sqrt корінь function "(корінь число)" "Обчислює квадратний корінь.")
    (doc arithmetic isqrt цілий-корінь function "(цілий-корінь ціле)" "Повертає цілу частину квадратного кореня невід'ємного цілого.")
    (doc arithmetic min-list найменше-у-списку function "(найменше-у-списку числа)" "Повертає найменший елемент списку чисел.")
    (doc arithmetic max-list найбільше-у-списку function "(найбільше-у-списку числа)" "Повертає найбільший елемент списку чисел.")
    (doc comparison < менше? predicate "(менше? a b ...)" "Питає, чи числа строго зростають зліва направо.")
    (doc comparison > більше? predicate "(більше? a b ...)" "Питає, чи числа строго спадають зліва направо.")
    (doc comparison = рівне? predicate "(рівне? a b ...)" "Питає, чи числові значення рівні.")
    (doc comparison <= не-більше? predicate "(не-більше? a b ...)" "Питає, чи кожне наступне число не менше попереднього.")
    (doc comparison >= не-менше? predicate "(не-менше? a b ...)" "Питає, чи кожне наступне число не більше попереднього.")
    (doc predicate not хибне? predicate "(хибне? значення)" "Повертає t рівно тоді, коли значення є ().")
    (doc predicate equal? однакові? predicate "(однакові? a b)" "Питає про глибоку структурну рівність значень.")
    (doc predicate symbol? символ? predicate "(символ? значення)" "Питає, чи значення є символом.")
    (doc predicate string? текст? predicate "(текст? значення)" "Питає, чи значення є текстовим рядком.")
    (doc predicate string<? текст-передує? predicate "(текст-передує? a b)" "Питає, чи рядок a лексикографічно менший за b.")
    (doc predicate numeric-buffer? числовий-буфер? predicate "(числовий-буфер? значення)" "Питає, чи значення є типізованим числовим буфером.")
    (doc list list список function "(список значення ...)" "Будує правильний список з усіх аргументів.")
    (doc list length довжина function "(довжина список)" "Повертає кількість елементів правильного списку.")
    (doc list append приєднати function "(приєднати лівий правий)" "Приєднує елементи лівого списку перед правим.")
    (doc list reverse зворот function "(зворот список)" "Повертає список у зворотному порядку.")
    (doc list nth елемент-списку-за-номером function "(елемент-списку-за-номером індекс список)" "Повертає елемент списку за нульовим індексом.")
    (doc list member? містить? predicate "(містить? значення список)" "Питає, чи список містить структурно однакове значення.")
    (doc list assoc знайти-за-ключем function "(знайти-за-ключем ключ alist)" "Шукає пару з ключем в асоціативному списку.")
    (doc list pair пара function "(пара ліве праве)" "Будує двоелементний правильний список.")
    (doc list second друге function "(друге список)" "Повертає другий елемент списку.")
    (doc list third третє function "(третє список)" "Повертає третій елемент списку.")
    (doc list fourth четверте function "(четверте список)" "Повертає четвертий елемент списку.")
    (doc list fifth п'яте function "(п'яте список)" "Повертає п'ятий елемент списку.")
    (doc higher-order map відобразити function "(відобразити функція список)" "Застосовує функцію до кожного елемента й повертає список результатів.")
    (doc higher-order filter відсіяти function "(відсіяти предикат список)" "Залишає лише елементи, для яких предикат істинний.")
    (doc higher-order reduce згорнути function "(згорнути функція початкове список)" "Згортає список зліва направо через акумулятор.")
    (doc string string-append зчепити function "(зчепити текст-a текст-b)" "З'єднує два текстові рядки.")
    (doc string string-length довжина-тексту function "(довжина-тексту текст)" "Повертає кількість Unicode-символів у рядку.")
    (doc string string-empty? текст-порожній? predicate "(текст-порожній? текст)" "Питає, чи рядок порожній.")
    (doc string string-prefix? текст-починається? predicate "(текст-починається? префікс текст)" "Питає, чи текст починається з указаного префікса.")
    (doc string string-contains? містить-текст? predicate "(містить-текст? фрагмент текст)" "Питає, чи текст містить заданий фрагмент.")
    (doc string string-first перший-символ-тексту function "(перший-символ-тексту текст)" "Повертає перший Unicode-символ як односимвольний рядок.")
    (doc string string-rest решта-символів-тексту function "(решта-символів-тексту текст)" "Повертає рядок без першого Unicode-символу.")
    (doc string string-slice відрізати function "(відрізати текст початок кінець)" "Повертає зріз рядка за індексами Unicode-символів.")
    (doc string symbol->string символ-у-текст function "(символ-у-текст символ)" "Перетворює символ на його текстове написання.")
    (doc string string->symbol текст-у-символ function "(текст-у-символ текст)" "Створює символ з текстового рядка.")
    (doc string codepoint->string код-у-текст function "(код-у-текст код)" "Перетворює Unicode code point на односимвольний рядок.")
    (doc string string->codepoint текст-у-код function "(текст-у-код текст)" "Повертає Unicode code point односимвольного рядка.")
    (doc string number->string число-у-текст function "(число-у-текст число)" "Повертає канонічне текстове представлення числа.")
    (doc io print друкувати function "(друкувати значення)" "Додає друковане представлення значення до виходу й повертає саме значення.")
    (doc io princ показати function "(показати значення)" "Виводить значення; текст показує без лапок та escape-послідовностей.")
    (doc io read прочитати function "(прочитати текст)" "Читає рівно одну Lisp-форму з рядка як дані, не обчислюючи її.")
    (doc io read-all прочитати-усе function "(прочитати-усе текст)" "Читає всі верхньорівневі форми з рядка як список даних.")
    (doc io write-to-string у-текст function "(у-текст значення)" "Серіалізує значення у канонічне Lisp-написання.")
    (doc io eval обчислити function "(обчислити форма)" "Обчислює форму-дані у поточному лексичному середовищі.")
    (doc io env середовище function "(середовище)" "Повертає видимі зв'язування поточного середовища як дані.")
    (doc vector vector вектор function "(вектор значення ...)" "Створює звичайний вектор з аргументів.")
    (doc vector make-vector створити-вектор function "(створити-вектор розмір)" "Створює вектор заданого розміру.")
    (doc vector vector-length довжина-вектора function "(довжина-вектора вектор)" "Повертає кількість елементів звичайного вектора.")
    (doc vector vector-ref елемент-вектора function "(елемент-вектора вектор індекс)" "Повертає елемент звичайного вектора за індексом.")
    (doc vector vector-set! встановити-елемент-вектора! mutation "(встановити-елемент-вектора! вектор індекс значення)" "Змінює елемент звичайного вектора на місці; знак ! попереджає про мутацію.")
    (doc time mono-ns монотонний-нс function "(монотонний-нс)" "Повертає монотонне спостереження часу в наносекундах від хоста.")
    (doc time unix-time-now юнікс-час-зараз function "(юнікс-час-зараз)" "Повертає сире спостереження Unix-часу від хоста.")
    (doc time utc-now поточний-всч function "(поточний-всч)" "Перетворює поточне Unix-спостереження на календарний ВСЧ у Lisp.")
    (doc time utc-from-unix всч-із-юнікс function "(всч-із-юнікс секунди наносекунда)" "Детерміновано перетворює Unix timestamp на календарний ВСЧ.")
    (doc time unix-time-observation->utc юнікс-спостереження-у-всч function "(юнікс-спостереження-у-всч спостереження)" "Інтерпретує сире (unix-time ...) спостереження як календарний ВСЧ.")
    (doc time milliseconds-from-nanoseconds мілісекунди-із-наносекунд function "(мілісекунди-із-наносекунд наносекунди)" "Перетворює невід'ємні наносекунди на цілі мілісекунди.")
    (doc time mono-ms монотонний-мс function "(монотонний-мс)" "Повертає монотонне спостереження часу в цілих мілісекундах.")
    (doc time timezone-name назва-часового-поясу function "(назва-часового-поясу конфігурація)" "Повертає назву часового поясу з конфігурації.")
    (doc time timezone-detect визначити-часовий-пояс function "(визначити-часовий-пояс)" "Інтерпретує оголошення хоста й повертає detected/unknown результат.")
    (doc time timezone-offset-seconds зміщення-часового-поясу-в-секундах function "(зміщення-часового-поясу-в-секундах конфігурація)" "Повертає зміщення часового поясу в секундах.")
    (doc time deadline-reached? дедлайн-досягнуто? predicate "(дедлайн-досягнуто? дедлайн-нс)" "Питає, чи поточний монотонний час уже досяг дедлайну.")
    (doc time deadline-reached-at? дедлайн-досягнуто-на-момент? predicate "(дедлайн-досягнуто-на-момент? зараз-нс дедлайн-нс)" "Чиста версія питання: чи заданий час уже досяг дедлайну.")
    (doc time elapsed-ns минуло-нс function "(минуло-нс початок-нс)" "Повертає наносекунди, що минули від заданого монотонного моменту.")
    (doc time deadline-from дедлайн-від function "(дедлайн-від зараз-нс дельта-нс)" "Будує дедлайн як суму заданого моменту й інтервалу.")
    (doc time deadline-after-ns дедлайн-після-нс function "(дедлайн-після-нс дельта-нс)" "Будує дедлайн від поточного монотонного часу.")
    (doc time internet-time-sync запитати-інтернет-час function "(запитати-інтернет-час хост таймаут-мс)" "Виконує сирий NTP-запит і в Lisp інтерпретує його як accepted/rejected спостереження.")
    (doc persistent-map map-empty порожня-карта value "порожня-карта" "Порожня персистентна AVL-карта; це значення, не предикат.")
    (doc persistent-map map-get отримати-з-карти function "(отримати-з-карти ключ карта)" "Повертає () якщо ключа нема або одноелементний список (значення), якщо є.")
    (doc persistent-map map-insert вставити-в-карту function "(вставити-в-карту ключ значення карта)" "Повертає нову персистентну карту, не змінюючи стару.")
    (doc persistent-map map-contains? карта-містить? predicate "(карта-містить? ключ карта)" "Питає, чи карта містить ключ.")
    (doc persistent-map map->list карта-у-список function "(карта-у-список карта)" "Повертає пари карти як список у відсортованому порядку ключів.")
    (doc persistent-vector vec-empty порожній-вектор value "порожній-вектор" "Порожній персистентний вектор; це значення, не предикат.")
    (doc persistent-vector vec-conj додати-до-вектора function "(додати-до-вектора значення вектор)" "Повертає новий персистентний вектор з елементом у кінці.")
    (doc persistent-vector vec-count розмір-вектора function "(розмір-вектора вектор)" "Повертає кількість елементів персистентного вектора.")
    (doc persistent-vector vec-nth елемент-вектора-за-номером function "(елемент-вектора-за-номером індекс вектор)" "Повертає () поза межами або (значення) для наявного індексу.")
    (doc persistent-vector vec->list вектор-у-список function "(вектор-у-список вектор)" "Перетворює персистентний вектор на звичайний список.")
    (doc persistent-vector vec-from-list вектор-із-списку function "(вектор-із-списку список)" "Будує персистентний вектор зі списку, зберігаючи порядок.")
    (doc knowledge is-fact? факт? predicate "(факт? clause)" "Питає, чи clause є фактом без умов, а не правилом.")
    (doc knowledge describe описати function "(описати елемент модуль)" "Повертає відомі факти про елемент у модулі або Module-not-found.")
    (doc knowledge collect-facts-about зібрати-факти-про function "(зібрати-факти-про елемент clauses)" "Відбирає факти, голова яких згадує заданий атом.")
    (doc knowledge contains-atom? містить-атом? predicate "(містить-атом? атом список)" "Питає, чи список безпечно містить заданий атом.")
    (doc knowledge forward-in пряме-виведення function "(пряме-виведення модуль)" "Матеріалізує всі вивідні факти модуля forward-chaining до фіксованої точки.")
    (doc knowledge reason-in логічний-висновок function "(логічний-висновок модуль мета)" "Шукає backward-chaining доведення мети в указаному модулі.")
    (doc knowledge check-conflict конфлікт? predicate "(конфлікт? модуль правила)" "Питає, чи протилежність голови запропонованого правила вже довідна.")
    (doc knowledge module-known? модуль-відомий? predicate "(модуль-відомий? модуль)" "Питає, чи модуль коли-небудь мав події у журналі знань.")
    (doc knowledge module-clauses-now поточні-клаузи-модуля function "(поточні-клаузи-модуля модуль)" "Проєктує поточний список clauses модуля з append-only журналу.")
    (doc reasoning prove-goal довести-мету function "(довести-мету мета правила підстановка всі-правила глибина)" "Шукає всі доведення однієї мети, протягуючи підстановку й індекс правил.")
    (doc reasoning prove-goals довести-мети function "(довести-мети цілі підстановка всі-правила глибина)" "Доводить кон'юнкцію цілей, протягуючи підстановки.")
    (doc reasoning explain-proof пояснити-доведення function "(пояснити-доведення доведення)" "Друкує деревоподібне пояснення того, як отримано доведення.")
    (doc reasoning source-of джерело-доведення function "(джерело-доведення вузол)" "Класифікує вузол доведення як fact або rule.")
    (doc reasoning provenance походження function "(походження вузол)" "Будує структуроване походження твердження з дерева доведення.")
    (doc reasoning reason міркування function "(міркування мета правила-або-індекс)" "Публічний backward-chaining пошук: повертає список пар (підстановка доведення) або ().")
    (doc reasoning reason-explain пояснити-міркування function "(пояснити-міркування мета правила)" "Запускає міркування й друкує людське пояснення першого доведення або невдачі.")
    (doc unification unify уніфікувати function "(уніфікувати a b підстановка)" "Уніфікує два терми й повертає нову підстановку або атом fail.")
    (doc unification logic-var логічна-змінна function "(логічна-змінна ім'я)" "Створює логічну змінну у формі (var ім'я).")
    (doc unification var? змінна? predicate "(змінна? терм)" "Питає, чи терм має канонічну форму логічної змінної.")
    (doc unification apply-subst підставити function "(підставити терм підстановка)" "Повністю застосовує підстановку до терма, включно з вкладеними структурами.")
    (doc unification walk розіменувати function "(розіменувати терм підстановка)" "Розіменовує зв'язану логічну змінну через підстановку.")
    (doc unification occurs-check змінна-зустрічається? predicate "(змінна-зустрічається? змінна терм підстановка)" "Питає, чи змінна трапляється в термі після розіменування; захищає від нескінченних структур.")
    (doc epistemic claim? твердження? predicate "(твердження? значення)" "Питає, чи значення має канонічну форму епістемічного твердження.")
    (doc epistemic claim-statement зміст-твердження function "(зміст-твердження твердження)" "Повертає statement-поле твердження.")
    (doc epistemic claim-review стан-розгляду-твердження function "(стан-розгляду-твердження твердження)" "Повертає review-поле твердження.")
    (doc epistemic evidence? доказ? predicate "(доказ? значення)" "Питає, чи значення має канонічну форму evidence-запису.")
    (doc epistemic evidence-method метод-доказу function "(метод-доказу доказ)" "Повертає метод отримання evidence.")
    (doc epistemic evidence-outcome результат-доказу function "(результат-доказу доказ)" "Повертає outcome evidence-запису.")
    (doc epistemic observation? спостереження? predicate "(спостереження? значення)" "Питає, чи значення має канонічну форму спостереження.")
    (doc epistemic observation-statement зміст-спостереження function "(зміст-спостереження спостереження)" "Повертає statement-поле спостереження.")
    (doc epistemic intent? намір? predicate "(намір? значення)" "Питає, чи значення має канонічну форму наміру.")
    (doc epistemic intent-goal мета-наміру function "(мета-наміру намір)" "Повертає ціль із запису наміру.")
    (doc epistemic supporting-evidence підтримувальний-доказ function "(підтримувальний-доказ claim-ref evidence-list)" "Повертає відповідний evidence-запис або (); це не предикат, бо успіх повертає дані.")
    (doc other identity без-змін function "(без-змін значення)" "Повертає аргумент без змін.")
    (doc other gensym генерувати-символ function "(генерувати-символ префікс)" "Створює свіже символічне ім'я з указаним текстовим префіксом.")
    (doc other and та macro "(та вираз ...)" "Короткозамикально обчислює кон'юнкцію й повертає саме останнє істинне значення або ().")
    (doc other or або macro "(або вираз ...)" "Короткозамикально повертає перше істинне значення або ().")
    (doc other let нехай macro "(нехай ((ім'я значення) ...) тіло)" "Створює паралельні лексичні зв'язування для одного тіла.")
    (doc other let* нехай* macro "(нехай* ((ім'я значення) ...) тіло)" "Створює послідовні лексичні зв'язування: кожне наступне бачить попередні.")
  ))
