; Машинно-читані метадані українського публічного API.
; Це документаційний індекс, а не семантична влада.
; Numeric ID↔UK мусить точно збігатися зі stable UK-рядками semantic-registry.wsm.

(uk-api-docs
  (schema uk-api-docs/2)
  (count 140)
  (kinds (form macro function predicate mutation value))
  (docs
    (doc canon 0001 як-є form "(як-є форма)" "Повертає форму як дані, не обчислюючи її.")
    (doc canon 0002 атом? predicate "(атом? значення)" "Питає, чи значення є атомом, тобто не парою.")
    (doc canon 0003 тотожне? predicate "(тотожне? ліве праве)" "Питає про канонічну тотожність двох атомарних значень.")
    (doc canon 0004 сполучити function "(сполучити голова хвіст)" "Створює пару з голови та хвоста.")
    (doc canon 0005 перше function "(перше пара)" "Повертає голову пари.")
    (doc canon 0006 решта function "(решта пара)" "Повертає хвіст пари.")
    (doc canon 0007 за-умовою form "(за-умовою (умова вираз) ...)" "Перевіряє гілки по черзі та обчислює вираз першої істинної умови.")
    (doc forms 0010 функція form "(функція (параметри ...) тіло ...)" "Створює лексичне замикання з параметрами й тілом.")
    (doc forms 0011 визначити form "(визначити ім'я значення)" "Створює або оновлює зв'язування імені у поточному середовищі.")
    (doc forms 0012 визначити-макрос macro "(визначити-макрос ім'я (параметри ...) тіло)" "Визначає макрос, що отримує необчислені форми аргументів.")
    (doc arithmetic 0104 додати function "(додати число ...)" "Додає числа, зберігаючи точність exact-значень.")
    (doc arithmetic 1001 відняти function "(відняти число ...)" "Віднімає наступні числа від першого.")
    (doc arithmetic 1002 помножити function "(помножити число ...)" "Множить числа.")
    (doc arithmetic 1003 поділити function "(поділити число дільник ...)" "Ділить і для exact-аргументів повертає точний раціональний результат.")
    (doc arithmetic 1004 модуль function "(модуль число)" "Повертає абсолютне значення числа.")
    (doc arithmetic 1005 найменше function "(найменше число ...)" "Повертає найменше з переданих чисел.")
    (doc arithmetic 1006 найбільше function "(найбільше число ...)" "Повертає найбільше з переданих чисел.")
    (doc arithmetic 1007 остача function "(остача число дільник)" "Повертає остачу від цілочисельного ділення.")
    (doc arithmetic 1008 частка function "(частка число дільник)" "Повертає цілу частку від ділення.")
    (doc arithmetic 1009 корінь function "(корінь число)" "Обчислює квадратний корінь.")
    (doc arithmetic 1010 цілий-корінь function "(цілий-корінь ціле)" "Повертає цілу частину квадратного кореня невід'ємного цілого.")
    (doc arithmetic 1011 найменше-у-списку function "(найменше-у-списку числа)" "Повертає найменший елемент списку чисел.")
    (doc arithmetic 1012 найбільше-у-списку function "(найбільше-у-списку числа)" "Повертає найбільший елемент списку чисел.")
    (doc comparison 1014 менше? predicate "(менше? a b ...)" "Питає, чи числа строго зростають зліва направо.")
    (doc comparison 1015 більше? predicate "(більше? a b ...)" "Питає, чи числа строго спадають зліва направо.")
    (doc comparison 1016 рівне? predicate "(рівне? a b ...)" "Питає, чи числові значення рівні.")
    (doc comparison 1017 не-більше? predicate "(не-більше? a b ...)" "Питає, чи кожне наступне число не менше попереднього.")
    (doc comparison 1018 не-менше? predicate "(не-менше? a b ...)" "Питає, чи кожне наступне число не більше попереднього.")
    (doc predicate 1021 хибне? predicate "(хибне? значення)" "Повертає t рівно тоді, коли значення є ().")
    (doc predicate 1022 однакові? predicate "(однакові? a b)" "Питає про глибоку структурну рівність значень.")
    (doc predicate 1023 символ? predicate "(символ? значення)" "Питає, чи значення є символом.")
    (doc predicate 1024 текст? predicate "(текст? значення)" "Питає, чи значення є текстовим рядком.")
    (doc predicate 1025 текст-передує? predicate "(текст-передує? a b)" "Питає, чи рядок a лексикографічно менший за b.")
    (doc predicate 1026 числовий-буфер? predicate "(числовий-буфер? значення)" "Питає, чи значення є типізованим числовим буфером.")
    (doc list 1027 список function "(список значення ...)" "Будує правильний список з усіх аргументів.")
    (doc list 1028 довжина function "(довжина список)" "Повертає кількість елементів правильного списку.")
