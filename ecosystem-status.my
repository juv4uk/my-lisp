; ecosystem-status.my — machine-readable current-state snapshot for the
; four-repository ecosystem (my-lisp, fpga-lisp, cml, my-idea).
;
; Data only, same convention as language-contract.my/isa-contract.my/
; compatibility.my — one flat alist, read via (read-file ...) or (read
; (read-file "ecosystem-status.my")), never loaded as executable source.
; docs/ecosystem-sync.md's prose narrates the same facts for humans;
; this file is the version another session's my-lisp code could actually
; consume (e.g. a future my-idea "System Observatory" panel) without
; scraping Markdown.
;
; Not the contract itself — language-contract.my/isa-contract.my/
; compatibility.my remain authoritative; this file is a snapshot,
; refreshed by hand after each cross-session sync, per
; docs/ecosystem-sync.md's four-point status request.
;
; ecosystem-status.my — машинно-читаний знімок поточного стану
; чотирьох-репозиторної екосистеми. Дані, не код; та сама конвенція, що
; й у language-contract.my/isa-contract.my/compatibility.my.

((kind . ecosystem-status)
 (as-of . "2026-08-11")
 (repositories .
  ((my-lisp .
    ((role . semantic-source-of-truth)
     (language-contract . (1 0))
     (exactness-model . fully-implemented)
     (blocking-others . nil)
     (rust-toolchain-on-this-machine . (installed 1 97 1))
     (msvc-linker-status . install-in-progress)))
   (fpga-lisp .
    ((role . hardware-implementation)
     (isa-contract . (0 2))
     (hardware-verified-milestones . (m01 . m27))
     (conformance-my-running . nil)
     (open-blocker . letrec-in-closures)
     (open-blocker-note . "blocks bootstrapping length/reverse/append/map from core.my")
     (isa-representational-gaps . (no-inexact-numbers no-rationals no-string-tag))))
   (cml .
    ((role . aot-compiler)
     (compiler-version . (0 1 0))
     (tested-my-lisp-sha . "ed10151")
     (tested-fpga-lisp-sha . "01bb01a")
     (tier-1-fixtures . (29 . 34))
     (equal-status . merged-unverified)
     (equal-commit . "6b884a8")
     (equal-blocked-on . fpga-simulator-toolchain-missing-in-session)
     (defmacro-status . not-started)
     (ci-status . created)
     (ci-created-without-user-confirmation . t)
     (documented-limitations . (no-inexact-numbers no-rationals no-canonical-strings
                                 no-more-than-eight-call-arguments))))
   (my-idea .
    ((role . observer-and-ide)
     (joined-ecosystem-sync . "2026-08-11")
     (depends-on-my-lisp-via . (cargo-git-dependency git-submodule))
     (revision-sync-risk . manual-only-no-ci-invariant)
     (planned-feature . system-observatory)))))
 (open-blockers .
  ((letrec-in-fpga-lisp-closures .
    "blocks cml's Tier-3-adjacent fixtures indirectly and fpga-lisp's own core.my bootstrap directly")
   (no-ecosystem-ci-until-now .
    "cml created CI unilaterally 2026-08-11 before user confirmation arrived; flagged, not reverted as of this snapshot")
   (isa-no-inexact-rational-string .
    "representational gap, not an implementation gap; blocks my-lisp's stated core purpose (exact rational arithmetic) from ever reaching fpga-lisp until isa-contract.my adds tags/encoding for it")))
 (pending-user-decisions .
  ((cml-ci-after-the-fact . "accept cml's unilateral CI creation, or have it reverted?")))
 (how-to-refresh .
  "Ask the four-point status request from docs/ecosystem-sync.md via the CCD session-management message tool, then hand-update this file's relevant repositories/open-blockers entries. Keep docs/ecosystem-sync.md and ecosystem-status.md's prose in sync with this file's facts."))
