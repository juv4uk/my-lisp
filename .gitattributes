# GitHub Linguist doesn't know the `.my` extension yet — it misdetected
# .my files as CLIPS. We map .my to Text so it shows up in the "Other"
# bucket on GitHub's language stats, until MyLisp is registered upstream
# via a Linguist PR. *.lisp stays explicitly Common-Lisp.
*.my linguist-language=Text
*.lisp linguist-language=Common-Lisp
