#!/usr/bin/env bash
set -euo pipefail

# Перевіряє явно передані файли, або застейджені файли без аргументів.
# Свідомо не стверджує, що весь наявний борг локалізації закритий --
# перевіряє лише те, що торкається цей коміт.
if (($#)); then
  files=("$@")
else
  mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMRT)
fi

# Виявлення української кирилиці. ripgrep (rg) переважно, якщо є;
# інакше GNU grep -P (rg відсутній у деяких пісочницях агентів, і без
# фолбеку guard хибно позначав кожен файл як англомовний на таких хостах).
has_cyrillic() {
  if command -v rg >/dev/null 2>&1; then
    rg -q '[А-Яа-яІіЇїЄєҐґ]' "$1"
  else
    grep -qP '[А-Яа-яІіЇїЄєҐґ]' "$1"
  fi
}

# Номер першого рядка зі "справжнім" українським контентом -- кирилиця
# ПОЗА markdown-посиланнями. Наївний пошук кирилиці будь-де хибно
# спрацьовує на TOC-рядках на кшталт
# "[English](#english) · [Українська](#українська)", де кирилиця є
# лише в тексті посилання, не в реальній прозі. AWK: для кожного рядка
# прибрати всі `[текст](url)` конструкції, тоді перевірити кирилицю в
# тому, що лишилось.
first_real_cyrillic_line() {
  awk '
    { line = $0
      gsub(/\[[^]]*\]\([^)]*\)/, "", line)
      if (line ~ /[А-Яа-яІіЇїЄєҐґ]/) { print NR; exit }
    }
  ' "$1"
}

# Номер першого рядка з markdown-заголовком секції "English"/"Deutsch"
# (короткі опції grep передаються ОКРЕМО -n -m 1 -i -E, не згруповано
# -nmi1E -- GNU grep мовчки не знаходить нічого при такому групуванні,
# з'ясовано живим тестуванням, не з документації).
first_english_heading_line() {
  grep -n -m 1 -i -E '^#{1,6}[[:space:]]*(english|deutsch)\b' "$1" 2>/dev/null \
    | cut -d: -f1 || true
}

# Кількість СИМВОЛІВ кирилиці (не рядків -- рядок ваговито не рівний
# рядку: короткий трилінгвальний заголовок на кшталт "## Quick try ·
# Швидко спробувати · Schnell ausprobieren" важить як один "рядок з
# кирилицею", хоча реального українського тексту там на пів фрази,
# тоді як повний абзац прози важить так само "один рядок" -- рахунок
# по рядках підробний тест сплутав; символи -- чесніший proxy обсягу.
# ДО заданого рядка і ПІСЛЯ (включно), поза markdown-посиланнями.
cyrillic_chars_before_after() {
  local file="$1" split_line="$2"
  awk -v split_line="$split_line" '
    { line = $0
      gsub(/\[[^]]*\]\([^)]*\)/, "", line)
      n = gsub(/[А-Яа-яІіЇїЄєҐґ]/, "", line)
      if (NR < split_line) before += n
      else after += n
    }
    END { printf "%d %d", before+0, after+0 }
  ' "$file"
}

failed=0
for file in "${files[@]}"; do
  [[ -f "$file" ]] || continue
  case "$file" in
    *.uk.md) continue ;;
    AGENTS.md|README*.md|memory/*.md|docs/*.md|docs/**/*.md|plans/*.md|plans/**/*.md) ;;
    *) continue ;;
  esac

  directory=${file%/*}
  name=${file##*/}
  stem=${name%.md}
  [[ "$directory" == "$file" ]] && directory=.
  sibling="$directory/$stem.uk.md"
  has_sibling=0
  [[ -f "$sibling" ]] && has_cyrillic "$sibling" && has_sibling=1

  if ! has_cyrillic "$file"; then
    if ((has_sibling)); then
      continue # ok -- окремий український sibling-файл несе зміст
    fi
    printf 'English-only human documentation: %s (expected Ukrainian content or %s)\n' \
      "$file" "$sibling" >&2
    failed=1
    continue
  fi

  ((has_sibling)) && continue # sibling-форма не має внутрішньої структури для порівняння

  # Дві незалежні перевірки, обидві застосовуються завжди (не
  # взаємовиключні -- файл може мати секцію "## English" І ОКРЕМО
  # мати розлогий англомовний вступ БЕЗ позначеної секції перед першою
  # українською згадкою; кожна перевірка ловить свій клас боргу).

  en_line=$(first_english_heading_line "$file")
  if [[ -n "$en_line" ]]; then
    # Секція "## English" є -- порівнюємо ОБСЯГ реального українського
    # контенту до і після неї (символи, не рядки -- короткий
    # трилінгвальний тег-заголовок не мусить важити як повний абзац).
    read -r before after <<< "$(cyrillic_chars_before_after "$file" "$en_line")"
    if (( before == 0 )) || (( after > before )); then
      printf 'English-first content order: %s (English/Deutsch heading at line %s; %d Ukrainian char(s) before it, %d after) -- move the Ukrainian content before it, per language-policy.wsm human-facing-order\n' \
        "$file" "$en_line" "$before" "$after" >&2
      failed=1
    fi
  fi

  # Незалежно від наявності секції "English": українська може бути
  # лише куцим фрагментом у кінці великого файлу (напр. одне речення
  # ліцензії наприкінці розлогого англійського тексту), поки основний
  # текст перед нею -- англійська проза без жодної позначеної секції
  # взагалі. Евристика: реальна кирилиця має з'явитись у першій
  # половині файлу. Пропускається для зовсім коротких файлів
  # (< 10 рядків) -- короткий stub з одним українським реченням
  # ліцензії не потребує цієї перевірки, там немає з чим порівнювати
  # "першу половину".
  total_lines=$(wc -l < "$file")
  if (( total_lines >= 10 )); then
    uk_line=$(first_real_cyrillic_line "$file")
    if [[ -n "$uk_line" ]] && (( uk_line * 2 > total_lines )); then
      printf 'Ukrainian content only in back half of file: %s (first real Cyrillic at line %s of %s) -- expected Ukrainian-primary prose near the start, per language-policy.wsm\n' \
        "$file" "$uk_line" "$total_lines" >&2
      failed=1
    fi
  fi
done

exit "$failed"
