; Перший repo-owned guard для майбутнього повністю українського source.
; Сам guard написано через українську Canon surface і має розширення .всм.
;
; Тимчасові bootstrap-винятки нижче потрібні лише тому, що host/core helpers
; `read-file`, `read-all`, `print`, `member?`, `equal?`, `string?`, `length`,
; `list` ще не всі мають Canon-owned українські IDs. Вся логіка після цього
; працює українськими повними назвами. Після #75/#77 ці містки треба прибрати,
; а не перетворити на постійний англомовний fallback.

(визначити прочитати-файл
  (функція (шлях)
    (read-file шлях)))
(визначити прочитати-усе read-all)
(визначити надрукувати print)
(визначити значення-у-списку? member?)
(визначити однакові? equal?)
(визначити текст? string?)
(визначити довжина length)
(визначити список list)

(визначити друге-значення
  (функція (значення)
    (перше (решта значення))))

(визначити третє-значення
  (функція (значення)
    (перше (решта (решта значення)))))

(визначити четверте-значення
  (функція (значення)
    (перше (решта (решта (решта значення))))))

(визначити знайти-секцію
  (функція (ім'я секції)
    (за-умовою
      ((атом? секції) ())
      ((тотожне? (перше (перше секції)) ім'я)
       (перше секції))
      (t
       (знайти-секцію ім'я (решта секції))))))

(визначити ідентичності-з-реєстру
  (функція (рядки)
    (за-умовою
      ((атом? рядки) ())
      (t
       (сполучити
         (перше (перше рядки))
         (ідентичності-з-реєстру (решта рядки)))))))

(визначити ідентичності-з-профілю
  (функція (рядки)
    (за-умовою
      ((атом? рядки) ())
      (t
       (сполучити
         (перше (перше рядки))
         (ідентичності-з-профілю (решта рядки)))))))

(визначити бажані-назви
  (функція (рядки)
    (за-умовою
      ((атом? рядки) ())
      ((тотожне? (третє-значення (перше рядки)) (як-є —))
       (бажані-назви (решта рядки)))
      (t
       (сполучити
         (третє-значення (перше рядки))
         (бажані-назви (решта рядки)))))))

(визначити є-дубль?
  (функція (значення)
    (за-умовою
      ((атом? значення) ())
      ((значення-у-списку? (перше значення) (решта значення)) t)
      (t (є-дубль? (решта значення))))))

(визначити зупинити-з-помилкою
  (функція (код значення)
    ; Перше обчислення друкує machine-readable причину, друге навмисно
    ; породжує помилку, щоб CLI/CI отримав ненульовий exit status.
    (сполучити
      (надрукувати (список (як-є помилка-українського-профілю) код значення))
      (перше ()))))

(визначити дозволені-стани
  (як-є (чинна кандидат-власника кандидат-повної-назви потребує-огляду)))

(визначити перевірити-рядок
  (функція (рядок реєстрові-ідентичності)
    (за-умовою
      ((значення-у-списку? (перше рядок) реєстрові-ідентичності)
       (за-умовою
         ((значення-у-списку? (четверте-значення рядок) дозволені-стани)
          (за-умовою
            ((тотожне? (четверте-значення рядок) (як-є чинна))
             (за-умовою
               ((однакові? (друге-значення рядок) (третє-значення рядок)) t)
               (t (зупинити-з-помилкою (як-є чинна-назва-не-збігається) рядок))))
            ((тотожне? (четверте-значення рядок) (як-є потребує-огляду))
             (за-умовою
               ((тотожне? (третє-значення рядок) (як-є —)) t)
               (t (зупинити-з-помилкою (як-є огляд-має-не-вгадувати-назву) рядок))))
            ((текст? (третє-значення рядок)) t)
            (t (зупинити-з-помилкою (як-є кандидат-потребує-текстової-назви) рядок))))
         (t (зупинити-з-помилкою (як-є невідомий-стан) рядок))))
      (t (зупинити-з-помилкою (як-є невідомий-semantic-id) рядок)))))

(визначити перевірити-рядки
  (функція (рядки реєстрові-ідентичності)
    (за-умовою
      ((атом? рядки) t)
      (t
       (сполучити
         (перевірити-рядок (перше рядки) реєстрові-ідентичності)
         (перевірити-рядки (решта рядки) реєстрові-ідентичності))))))

(визначити реєстр
  (перше
    (прочитати-усе
      (прочитати-файл "lib/surface/semantic-registry.wsm"))))

(визначити профіль
  (перше
    (прочитати-усе
      (прочитати-файл "lib/surface/український-профіль-джерела.всм"))))

(за-умовою
  ((тотожне? (перше реєстр) (як-є sr/1)) t)
  (t (зупинити-з-помилкою (як-є невідома-схема-реєстру) (перше реєстр))))

(за-умовою
  ((тотожне? (перше профіль) (як-є український-профіль-джерела/1)) t)
  (t (зупинити-з-помилкою (як-є невідома-схема-профілю) (перше профіль))))

(визначити секція-назв
  (знайти-секцію (як-є назви) (решта профіль)))

(за-умовою
  ((атом? секція-назв)
   (зупинити-з-помилкою (як-є відсутня-секція-назв) профіль))
  (t t))

(визначити рядки-назв (решта секція-назв))
(визначити реєстрові-ідентичності (ідентичності-з-реєстру (решта реєстр)))
(визначити профільні-ідентичності (ідентичності-з-профілю рядки-назв))
(визначити профільні-бажані-назви (бажані-назви рядки-назв))

(перевірити-рядки рядки-назв реєстрові-ідентичності)

(за-умовою
  ((є-дубль? профільні-ідентичності)
   (зупинити-з-помилкою (як-є дубль-semantic-id) профільні-ідентичності))
  (t t))

(за-умовою
  ((є-дубль? профільні-бажані-назви)
   (зупинити-з-помилкою (як-є дубль-бажаної-назви) профільні-бажані-назви))
  (t t))

(надрукувати
  (список
    (як-є український-профіль-джерела)
    (як-є гаразд)
    (список (як-є рядків) (довжина рядки-назв))
    (список (як-є semantic-id-перевірено) (довжина профільні-ідентичності))
    (список (як-є бажаних-назв) (довжина профільні-бажані-назви))))

(як-є ())
