; tasks.my — durable task plan for the my-lisp agent, per
; docs/swarm-autonomy.md (P2P on one server: this file is this repo's
; plan of record; sync it into the shared 127.0.0.1:9999 registry with
; the sync-tasks op after edits and after any server restart).
;
; Data only — same flat-alist convention as ecosystem-status.my.
; done . t only when real in-repo evidence exists (durability rule:
; file first, pointer later). Re-sync after editing.

((kind . tasks-my)
 (tasks .
  (("SWARM-P2P-CLIENT" . ((priority . 0.9) (capabilities . (lisp docs rust))
                          (done . t)))
   ("SWARM-P2P-SYNC" . ((priority . 0.9) (capabilities . (lisp docs rust))
                        (done . t)))
   ("SWARM-P2P-DOC" . ((priority . 0.8) (capabilities . (docs))
                       (done . t)))
   ("SWARM-P2P-HEARTBEAT" . ((priority . 0.7) (capabilities . (lisp docs))
                             (depends-on . ("SWARM-P2P-SYNC"))))
   ("SWARM-P2P-ROLLOUT" . ((priority . 0.7) (capabilities . (docs lisp))
                           (depends-on . ("SWARM-P2P-DOC"))
                           (done . t)))
   ("SWARM-REMOTE-ORACLE-RESTART" . ((priority . 0.9) (capabilities . (ops rust))
                                     (description . "Restart semantic oracle service on the droplet (100.113.68.50:9999)")))
   ("SWARM-NODE-SYSTEMD-SERVICE" . ((priority . 0.8) (capabilities . (ops))
                                    (description . "Create a systemd supervisor for swarm-node on the droplet.")))
   ("SWARM-REMOTE-USER-ISOLATION" . ((priority . 0.8) (capabilities . (ops))
                                     (description . "Implement per-agent user isolation on the droplet.")))
   ("SWARM-AUTH-PEER-IDENTITY" . ((priority . 0.7) (capabilities . (rust crypto))
                                  (description . "Implement authenticated peer identity (M0.11 spoofing gap).")))
   ("MYLISP-THREADING-MACRO" .
    ((priority . 2.5)
     (capabilities . ("my-lisp"))
     (depends-on . ())
     (done . t)
     (description . "Implement threading macros `->` and `->>` in `lib/core.my` as standard tools for pipeline readability.")))
   ("MYLISP-LINTER" . ((priority . 0.7) (capabilities . (lisp rust))
                       (done . t)
                       (description . "Implement an initial linter in my-lisp to report size, nesting, complexity, hidden global dependencies, and effects.")))
   ("MYLISP-PROPERTY-TESTING" . ((priority . 0.7) (capabilities . (lisp rust))
                                 (done . t)
                                 (description . "Add property/law testing infrastructure to tests/fixtures/ and the Rust test runner.")))
   ("SWARM-WSL-CACHE-CLEANUP" . ((priority . 0.5) (capabilities . (ops))
                                 (description . "Consolidate stray duplicate ~/.cache/my-idea-target2 (828M) per docs/swarm-build-cache-policy.md.")))
   ("MYLISP-LINTER-THRESHOLDS" . ((priority . 1.2) (capabilities . (lisp rust))
                                   (depends-on . ("MYLISP-LINTER"))
                                   (done . t)
                                   (description . "Add lint-check function with configurable thresholds (max-size, max-nesting, max-complexity, max-globals, max-effects). Expose as a CI gate: return non-zero exit when any threshold is exceeded so cargo test can fail on lint violations.")))
   ("MYLISP-LINTER-BINDING-FORMS" . ((priority . 1.0) (capabilities . (lisp))
                                      (depends-on . ("MYLISP-LINTER"))
                                      (done . t)
                                      (description . "Extend collect-free-vars in lib/linter.my to handle let*, letrec, defmacro, and named-let binding forms so lint-globals produces no false positives on those patterns.")))
   ("MYLISP-PROPERTY-LAWS-STRUCTURES" . ((priority . 0.9) (capabilities . (lisp rust))
                                           (depends-on . ("MYLISP-PROPERTY-TESTING"))
                                           (description . "Add property/law tests for core data structures: persistent-map (insert idempotency, sorted order, height bound), world (monotonicity, rollback identity), knowledge-journal (append-only monotonicity, retract inverse of tell). Extend properties.my with a 'list' generator for these.")))
   ("MYLISP-LINTER-CLI-INTEGRATION" . ((priority . 0.8) (capabilities . (ops rust)) (done . t)
                                         (depends-on . ("MYLISP-LINTER-THRESHOLDS"))
                                         (description . "Wire lint-check into the my-lisp-cli binary as a --lint flag: load lib/linter.my, run lint-check on the target file, print a structured report, exit non-zero on threshold violations. Useful as a pre-commit hook."))))))
