((expr . "(car 5)") (error . "Type") (tier . 1) (axioms . (S2)) (role . "constitutive"))
((expr . "(car '())") (error . "Type") (tier . 1) (axioms . (S2)) (role . "constitutive"))
((expr . "(eq '(1) '(2))") (error . "Type") (tier . 1) (axioms . (S2)) (role . "constitutive"))
((expr . "(undefined-symbol)") (error . "UnknownSymbol") (tier . 1) (axioms . (S2)) (note . "symbol lookup is core semantics (tier 1 explicitly lists \"symbols\"); not actually borderline with tier 2"))
((expr . "(lambda (x))") (error . "Arity") (tier . 2) (axioms . (S2)))
((expr . "(quote a b)") (error . "Arity") (tier . 1) (axioms . (S2)) (role . "constitutive"))
((expr . "(cons 1)") (error . "Arity") (tier . 1) (axioms . (S2)) (role . "constitutive"))
((expr . "(/ 1 0)") (error . "InvalidForm") (tier . 2) (axioms . (S2)))
((expr . "(let ((x 1) (y 2)) (+ x y))") (expected . "3") (tier . 3) (axioms . (G5)))
((expr . "(let* ((x 1) (y (+ x 1))) y)") (expected . "2") (tier . 3) (axioms . (G5)))
((expr . "(equal? '(1 (2 3) 4) '(1 (2 3) 4))") (expected . "t") (tier . 3) (axioms . (G5)))
((expr . "(equal? '(1 2) '(1 2 3))") (expected . "()") (tier . 3) (axioms . (G5)))
((expr . "(eq (lambda (x) x) (lambda (x) x))") (expected . "()") (tier . 2) (axioms . (G1)) (role . "constitutive"))
((expr . "(unify 'a 'a '())") (expected . "()") (tier . 3) (axioms . ()))
((expr . "(unify '(var x) 'a '())") (expected . "((x . a))") (tier . 3) (axioms . ()))
((expr . "(unify '(var x) '(var x) '())") (expected . "()") (tier . 3) (axioms . ()))
((expr . "(unify '(1 (var x) 3) '(1 2 3) '())") (expected . "((x . 2))") (tier . 3) (axioms . ()))
((expr . "(unify '(1 (var x) 3) '(1 2 4) '())") (expected . "fail") (tier . 3) (axioms . ()))
((expr . "(let ((rules '(((parent alice bob))))) (reason '(parent alice bob) rules))") (expected . "((() (proved (parent alice bob) (parent alice bob) ())))") (tier . 3) (axioms . ()))
((expr . "(let ((rules '(((parent alice bob))))) (reason (list 'parent (logic-var 'x) 'bob) rules))") (expected . "((((x . alice)) (proved (parent (var x) bob) (parent alice bob) ())))") (tier . 3) (axioms . ()))
((expr . "(let ((rules '(((bird (var x)) (animal (var x)) (not (penguin (var x)))) ((animal tweety)) ((animal pingu)) ((penguin pingu))))) (reason (list 'bird (logic-var 'x)) rules))") (expected . "(((((x . 0) . tweety) (x var (x . 0))) (proved (bird (var x)) (bird (var (x . 0))) ((proved (animal (var (x . 0))) (animal tweety) ()) (proved-not (penguin (var (x . 0))))))))") (tier . 3) (axioms . ()))
((expr . "(equal? '(p . 0) (cons 'p 0))") (expected . "t") (tier . 1) (axioms . (G2)))
((expr . "(car '(a b . c))") (expected . "a") (tier . 1) (axioms . (G2)) (role . "constitutive"))
((expr . "(cdr (cdr '(a b . c)))") (expected . "c") (tier . 1) (axioms . (G2)) (role . "constitutive"))
((expr . "(unify '(var x) '(f (var x)) '())") (expected . "fail") (tier . 3) (axioms . ()) (note . "occurs-check, principle 3 evidence — prevents building an infinite structure, not a G/S axiom"))
((expr . "(defmacro foo)") (error . "Arity") (tier . 2) (axioms . (S2)) (note . "defmacro validates arity like any other special form"))
((expr . "(defmacro 5 (x) x)") (error . "InvalidForm") (tier . 2) (axioms . (S2)) (note . "defmacro validates its name is a symbol, not just its arity"))
((expr . "(def count-down (lambda (n) (cond ((eq n 0) 'done) (t (count-down (- n 1)))))) (count-down 100000)") (expected . "done") (tier . 2) (axioms . (S3)) (note . "100,000-deep self-tail-call through the real evaluator stays O(1) host-stack usage regardless of recursion depth — previously only exercised by crates/my-lisp/tests/stack_safety.rs (Rust-specific), not the implementation-independent contract; a non-tail-call-optimizing future core would fail here, not just in production"))
((expr . "(map (lambda (x) (+ x 1)) '())") (expected . "()") (tier . 3) (axioms . (G5)) (note . "empty-list edge case, previously untested — map"))
((expr . "(filter (lambda (x) (eq x 2)) '())") (expected . "()") (tier . 3) (axioms . (G5)) (note . "empty-list edge case, previously untested — filter"))
((expr . "(reduce (lambda (acc x) (+ acc x)) 0 '())") (expected . "0") (tier . 3) (axioms . (G5)) (note . "empty-list edge case, previously untested — reduce returns its initial accumulator unchanged"))
((expr . "((lambda (a b . rest) rest) 1 2 3 4 5)") (expected . "(3 4 5)") (tier . 1) (axioms . (G2)) (role . "constitutive") (note . "dotted lambda-list: variadic parameter binding, added 2026-08-09 to let list move out of Rust"))
((expr . "((lambda args args) 1 2 3)") (expected . "(1 2 3)") (tier . 1) (axioms . (G2)) (role . "constitutive") (note . "bare-symbol lambda-list: zero fixed params, every argument bound as one list"))
((expr . "((lambda (a b . rest) a) 1)") (error . "Arity") (tier . 1) (axioms . (S2)) (role . "constitutive") (note . "variadic lambda still enforces its fixed parameters"))
((expr . "(list 1 2 3)") (expected . "(1 2 3)") (tier . 3) (axioms . (G5)) (note . "list moved from a Rust special form to lib/core.my (lambda args args) once variadic parameters existed to express it"))
((expr . "(let ((second (lambda (x) 'shadowed))) (second '(1 2 3)))") (expected . "shadowed") (tier . 2) (axioms . (G4)) (note . "neither Lisp-1 nor Lisp-2 as an identity — ordinary def/defmacro bindings share one namespace and are locally shadowable"))
((expr . "(let ((car (lambda (x) 'shadowed))) (car '(1 2)))") (expected . "1") (tier . 1) (axioms . (G4)) (role . "constitutive") (note . "the seven primitives are syntax, dispatched before any environment lookup, so never shadowable — the same distinction Scheme draws between special forms and procedures"))
((expr . "(reverse '())") (expected . "()") (tier . 3) (axioms . (G5)) (note . "empty-list edge case, previously untested"))
((expr . "(append '() '(a b))") (expected . "(a b)") (tier . 3) (axioms . (G5)) (note . "empty-list edge case, previously untested — empty first argument"))
((expr . "(append '(a b) '())") (expected . "(a b)") (tier . 3) (axioms . (G5)) (note . "empty-list edge case, previously untested — empty second argument"))
((expr . "(symbol? 'radio)") (expected . "t") (tier . 2) (axioms . ()) (note . "symbol/string introspection — previously tested only in Rust unit tests, not the implementation-independent contract"))
((expr . "(string? \"radio\")") (expected . "t") (tier . 2) (axioms . ()))
((expr . "(symbol->string 'radio)") (expected . "\"radio\"") (tier . 2) (axioms . ()))
((expr . "(string->symbol \"radio\")") (expected . "radio") (tier . 2) (axioms . ()))
((expr . "(string-first \"radio\")") (expected . "\"r\"") (tier . 2) (axioms . ()))
((expr . "(string-rest \"radio\")") (expected . "\"adio\"") (tier . 2) (axioms . ()))
((expr . "(read-all \"1 2 3\")") (expected . "(1 2 3)") (tier . 2) (axioms . (G3)) (note . "the multi-form counterpart to read — previously tested only in Rust unit tests"))
((expr . "(princ \"raw\")") (expected . "\"raw\"") (tier . 2) (axioms . ()) (note . "princ composes and returns its argument exactly like print — the raw/unquoted transcript output itself is regression-tested in crates/my-lisp/tests/mccarthy.rs since this fixture harness only checks the return value, not the print transcript"))
((expr . "(< 5)") (expected . "t") (tier . 2) (axioms . ()) (note . "a single argument is vacuously ordered, previously untested here"))
((expr . "(defmacro my-list items (cons 'quote (cons items '()))) (my-list 1 2 3)") (expected . "(1 2 3)") (tier . 1) (axioms . (G4)) (role . "constitutive") (note . "variadic defmacro success path — the error paths were already covered, the success path wasn't"))
((expr . "(understand '(earth is a planet))") (expected . "((planet earth))") (tier . 3) (axioms . ()) (note . "lib/understand.my — the controlled-natural-language bridge, previously tested only in Rust unit tests, not the implementation-independent contract"))
((expr . "(understand '(earth orbits sun))") (expected . "((orbits earth sun))") (tier . 3) (axioms . ()) (note . "subject-verb-object relation shape"))
((expr . "(understand '(all planet have mass))") (expected . "((has (var w) mass) (planet (var w)))") (tier . 3) (axioms . ()) (note . "universal-rule shape"))
((expr . "(narrate-fact (car (understand '(earth is a planet))))") (expected . "(earth is a planet)") (tier . 3) (axioms . ()) (note . "lib/narrate.my — the structure-to-text half of the bridge, previously tested only in Rust unit tests"))
((expr . "(equal? '(mars is a planet) (narrate-fact (car (understand '(mars is a planet)))))") (expected . "t") (tier . 3) (axioms . ()) (note . "understand and narrate-fact are direct inverses for the is-a shape"))
((expr . "(cond (0 'truthy) (t 'falsy))") (expected . "truthy") (tier . 1) (axioms . ()) (note . "0 is truthy in my-lisp, unlike C/Python/JS — only Nil and Bool(false) are falsy (Value::is_truthy). Not G8: G8 is narrowly about '() as list/boolean, not a general \"empty-shaped values are false\" rule. Independent of the item-10 exactness redesign — is_truthy never inspects a number's exactness, only Nil/Bool(false)."))
((expr . "(eq 3 3.0)") (expected . "()") (tier . 1) (axioms . (S1)) (note . "PLAN.md item 10, Path A: exactness is part of a number's identity — an exact integer and an inexact real of the same magnitude are different values, so eq (identity/atom equality) tells them apart."))
((expr . "(eq 3 3)") (expected . "t") (tier . 1) (axioms . (S1)) (note . "same exactness, same magnitude"))
((expr . "(eq 3.0 3.0)") (expected . "t") (tier . 1) (axioms . (S1)) (note . "same inexact value both sides"))
((expr . "(= 3 3.0)") (expected . "t") (tier . 1) (axioms . (S1)) (note . "= compares magnitude only, deliberately diverging from eq — 3 and 3.0 are the same mathematical quantity even though they are different values"))
((expr . "(print 3)") (expected . "3") (tier . 2) (axioms . (S1)) (note . "exact integer prints without a decimal point"))
((expr . "(print 3.0)") (expected . "3.0") (tier . 2) (axioms . (S1)) (note . "inexact real always prints with a decimal point, even when whole-valued — the fix for the original bug this item was opened for: (+ 2.0 1.0) used to print as \"3\", silently erasing the written-with-a-decimal-point intent"))
((expr . "(print 3.00)") (expected . "3.0") (tier . 2) (axioms . (S1)) (note . "3.0/3.00/3.000 are the same inexact value regardless of trailing zeros in the literal — canonical print form has exactly one decimal digit for a whole inexact number"))
((expr . "(+ 2.0 1.0)") (expected . "3.0") (tier . 2) (axioms . (S1)) (note . "inexact + inexact -> inexact; this is the exact expression that first exposed the bug (used to evaluate to 3, losing all trace of the decimal points)"))
((expr . "(+ 2.0 1)") (expected . "3.0") (tier . 2) (axioms . (S1)) (note . "exact + inexact -> inexact, one inexact operand contaminates the result"))
((expr . "(+ 2 1)") (expected . "3") (tier . 2) (axioms . (S1)) (note . "exact + exact -> exact, stays a precise integer"))
((expr . "(string-append \"hello, \" \"world\")") (expected . "\"hello, world\"") (tier . 2) (axioms . ()) (note . "PLAN.md item 14 — genuinely needs a Rust primitive, unlike string-length/string-contains? below: no existing primitive combines two strings into a new one"))
((expr . "(string<? \"a\" \"b\")") (expected . "t") (tier . 2) (axioms . ()) (note . "PLAN.md item 15 — the one Rust primitive the persistent-map design needed; ordering, not just equality, can't be derived from string-first/string-rest/eq alone"))
((expr . "(string<? \"b\" \"a\")") (expected . "()") (tier . 2) (axioms . ()))
((expr . "(map-get \"a\" (map-insert \"a\" 1 map-empty))") (expected . "(1)") (tier . 3) (axioms . (G5)) (note . "PLAN.md item 15 — lib/persistent-map.my, an AVL-balanced persistent tree built on cons/car/cdr alone, no mutation; map-get's \"maybe\" shape (() absent, (value) present) avoids confusing a stored () with not-found"))
((expr . "(map-get \"z\" (map-insert \"a\" 1 map-empty))") (expected . "()") (tier . 3) (axioms . (G5)))
((expr . "(string-length \"\")") (expected . "0") (tier . 3) (axioms . (G5)) (note . "PLAN.md item 14/20 — lib/core.my, expressible via string-first/string-rest/eq alone, no new Rust primitive needed"))
((expr . "(string-length \"hello\")") (expected . "5") (tier . 3) (axioms . (G5)))
((expr . "(string-prefix? \"hell\" \"hello\")") (expected . "t") (tier . 3) (axioms . (G5)))
((expr . "(string-prefix? \"world\" \"hello\")") (expected . "()") (tier . 3) (axioms . (G5)))
((expr . "(string-contains? \"ell\" \"hello\")") (expected . "t") (tier . 3) (axioms . (G5)))
((expr . "(string-contains? \"xyz\" \"hello\")") (expected . "()") (tier . 3) (axioms . (G5)))
((expr . "(tcp-connect 42 8099)") (error . "Type") (tier . 2) (axioms . ()) (note . "PLAN.md item 21 — a real listen/accept/connect round trip needs a live network peer, which conformance.my's single-session fixture runner can't provide; only the type-check error path is a pure expression testable this way. See crates/my-lisp/tests/tcp.rs for the live client/server round-trip, run on separate threads with separate Sessions."))
((expr . "(tcp-write \"not a connection\" \"x\")") (error . "Type") (tier . 2) (axioms . ()))
((expr . "(process-run \"git\" '())") (error . "InvalidForm") (tier . 2) (axioms . (S2)) (note . "PLAN.md item 21's follow-up — the default session (this fixture runner's own, and every conformance.my fixture's) never opts into Environment::with_process_allowlist, so process-run always fails named, never runs anything, matching S2. See crates/my-lisp/tests/mccarthy.rs's process_run_* tests for the allowlist opt-in path, which needs a session this single shared fixture-runner session can't provide per-fixture."))
