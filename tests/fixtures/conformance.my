((expr . "(equal? (read (write-to-string \"line\\n\\t\\\"\\\\\")) \"line\\n\\t\\\"\\\\\")") (expected . "t") (tier . 2) (axioms . (G6 S1)) (note . "canonical serialization round-trip: escaped string"))
