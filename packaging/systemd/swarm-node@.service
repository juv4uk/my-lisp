[Unit]
Description=WSM swarm-node %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/swarm-node/%i.env
ExecStart=%h/GitHub/my-lisp/target/release/swarm-node --port ${SWARM_PORT} --node-id %i --project ${SWARM_PROJECT} --data-dir ${SWARM_DATA_DIR} --bind ${SWARM_BIND} --connect ${SWARM_BOOTSTRAP} --auto-sync ${SWARM_TASKS_FILE}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
